{
  "navbar": {
    "$description": "Navbar's component tokens. Each one is an optional override: set the CSS variable (--navbar-<name>) on the page, a container or one navbar, and everything inside follows. Unset, it uses the shared token it references here; tools/test/foundation.mjs checks that bundle.css uses exactly these defaults.",
    "color": {
      "bg": {
        "$type": "color",
        "$value": "{color.surface}",
        "$description": "The bar's background.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--navbar-bg"
          }
        }
      },
      "bg-scrolled": {
        "$type": "color",
        "$value": "{color.surface-raised}",
        "$description": "A sticky bar's background once the page has scrolled under it, faded in with its shadow. In the dark themes it's the lighter raised surface, since a shadow barely shows on a near-black page; in the light ones it's the same white. Set it with --navbar-bg when you change that.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--navbar-bg-scrolled"
          }
        }
      },
      "border": {
        "$type": "color",
        "$value": "{color.border}",
        "$description": "The line under the bar.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--navbar-border"
          }
        }
      },
      "brand-text": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "The brand (logo and name) at the start of the bar.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--navbar-brand-text"
          }
        }
      },
      "link-text": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "A link (4.5:1 on bg and link-bg-hover).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--navbar-link-text"
          }
        }
      },
      "link-text-hover": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "A link on hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--navbar-link-text-hover"
          }
        }
      },
      "link-text-active": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "The current page's link.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--navbar-link-text-active"
          }
        }
      },
      "link-bg-hover": {
        "$type": "color",
        "$value": "{color.surface-hover}",
        "$description": "A link's background on hover: zinc-100 in light, like the current page's; only the current page draws the bar.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--navbar-link-bg-hover"
          }
        }
      },
      "menu-link-bg-hover": {
        "$type": "color",
        "$value": "{color.surface-raised-hover}",
        "$description": "A link in a menu panel on hover: the raised hover step, since the panel floats.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--navbar-menu-link-bg-hover"
          }
        }
      },
      "link-bg-active": {
        "$type": "color",
        "$value": "{color.surface-secondary}",
        "$description": "The current page's link background.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--navbar-link-bg-active"
          }
        }
      },
      "link-bg-active-hover": {
        "$type": "color",
        "$value": "{color.surface-secondary-hover}",
        "$description": "The current page's link background under the pointer: one step past its rest.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--navbar-link-bg-active-hover"
          }
        }
      },
      "link-indicator": {
        "$type": "color",
        "$value": "{color.surface-highlight-indicator}",
        "$description": "The 2px bar under the current page's link (at the start of a menu link), which hover never draws. Drawn only with more contrast: by default it has no width (`highlight-indicator-width`), and the fill alone marks the item.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--navbar-link-indicator"
          }
        }
      },
      "focus-ring": {
        "$type": "color",
        "$value": "{color.focus-ring}",
        "$description": "The keyboard focus ring.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--navbar-focus-ring"
          }
        }
      },
      "link-bg-pressed": {
        "$type": "color",
        "$value": "{color.surface-pressed}",
        "$description": "A link's fill while it's held down.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--navbar-link-bg-pressed"
          }
        }
      },
      "menu-bg": {
        "$type": "color",
        "$value": "{color.surface-raised}",
        "$description": "A dropdown panel's background (NavbarMenu).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--navbar-menu-bg"
          }
        }
      },
      "menu-border": {
        "$type": "color",
        "$value": "{color.border}",
        "$description": "A dropdown panel's border.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--navbar-menu-border"
          }
        }
      },
      "menu-title-text": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "A group's title in a dropdown panel (4.5:1 on menu-bg).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--navbar-menu-title-text"
          }
        }
      },
      "menu-link-text": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "A dropdown link's text (4.5:1 on menu-bg).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--navbar-menu-link-text"
          }
        }
      },
      "menu-desc-text": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "A dropdown link's description (4.5:1 on menu-bg).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--navbar-menu-desc-text"
          }
        }
      },
      "menu-divider": {
        "$type": "color",
        "$value": "{color.border-raised}",
        "$description": "What a divider or separator inside it reads as `border`: its own edge color, since in dark `border` is the surface's own color and a line in it vanished",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--navbar-menu-divider"
          }
        }
      }
    },
    "typography": {
      "link-size": {
        "$type": "dimension",
        "$value": "{fontSize.text-sm}",
        "$description": "Link text (14px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--navbar-link-size"
          }
        }
      },
      "link-weight": {
        "$type": "fontWeight",
        "$value": "{typography.font-medium}",
        "$description": "Link weight (500).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--navbar-link-weight"
          }
        }
      }
    },
    "sizing": {
      "height": {
        "$type": "dimension",
        "$value": "{spacing.spacing-16}",
        "$description": "The bar's height (64px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--navbar-height"
          }
        }
      },
      "height-condensed": {
        "$type": "dimension",
        "$value": "{spacing.spacing-12}",
        "$description": "A condensed sticky bar's height once the page has scrolled under it (48px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--navbar-height-condensed"
          }
        }
      }
    },
    "spacing": {
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-6}",
        "$description": "Space between the brand, the links and the actions (24px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--navbar-gap"
          }
        }
      },
      "link-gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1}",
        "$description": "Space between links (4px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--navbar-link-gap"
          }
        }
      },
      "link-padding-x": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3}",
        "$description": "A link's side padding (12px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--navbar-link-padding-x"
          }
        }
      },
      "link-padding-y": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "A link's top and bottom padding (8px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--navbar-link-padding-y"
          }
        }
      }
    },
    "border": {
      "border-width": {
        "$type": "dimension",
        "$value": "{borders.border-width-1}",
        "$description": "The line under the bar (1px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--navbar-border-width"
          }
        }
      }
    },
    "radius": {
      "link-radius": {
        "$type": "dimension",
        "$value": "{radius.radius-control}",
        "$description": "A link's corners (6px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--navbar-link-radius"
          }
        }
      }
    },
    "layout": {
      "z-index": {
        "$type": "number",
        "$value": "{layout.z-40}",
        "$description": "Above the page when sticky.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--navbar-z-index"
          }
        }
      }
    },
    "shadow": {
      "shadow-scrolled": {
        "$type": "shadow",
        "$value": "{shadow.elevation-raised}",
        "$description": "A sticky bar's shadow once the page has scrolled under it.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--navbar-shadow-scrolled"
          }
        }
      },
      "menu-shadow": {
        "$type": "shadow",
        "$value": "{shadow.elevation-overlay}",
        "$description": "A dropdown panel's shadow on wide screens.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--navbar-menu-shadow"
          }
        }
      }
    }
  }
}
