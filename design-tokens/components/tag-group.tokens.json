{
  "tagGroup": {
    "$description": "TagGroup's component tokens. Each one is an optional override: set the CSS variable (--tag-group-<name>) on the page, a container or one TagGroup, and every TagGroup inside follows. Unset, it uses the shared token it references here; tools/test/foundation.mjs checks that bundle.css uses exactly these defaults.",
    "color": {
      "bg": {
        "$type": "color",
        "$value": "{color.surface}",
        "$description": "A tag's background.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tag-group-bg"
          }
        }
      },
      "text": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "A tag's words (4.5:1 on bg).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tag-group-text"
          }
        }
      },
      "border": {
        "$type": "color",
        "$value": "{color.border-control}",
        "$description": "A tag's border (3:1 on the page, so the tag's edge is seen).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tag-group-border"
          }
        }
      },
      "bg-hover": {
        "$type": "color",
        "$value": "{color.surface-hover}",
        "$description": "A tag that can be picked, under the pointer. A picked tag keeps its own colors, as a pressed ToggleButton does.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tag-group-bg-hover"
          }
        }
      },
      "bg-pressed": {
        "$type": "color",
        "$value": "{color.pressed}",
        "$description": "A tag that can be picked, while it's held down, one step past bg-hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tag-group-bg-pressed"
          }
        }
      },
      "bg-selected": {
        "$type": "color",
        "$value": "{color.primary-subtle}",
        "$description": "A picked tag's background.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tag-group-bg-selected"
          }
        }
      },
      "text-selected": {
        "$type": "color",
        "$value": "{color.primary-text}",
        "$description": "A picked tag's words and tick (4.5:1 on bg-selected).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tag-group-text-selected"
          }
        }
      },
      "border-selected": {
        "$type": "color",
        "$value": "{color.primary-text}",
        "$description": "A picked tag's border.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tag-group-border-selected"
          }
        }
      },
      "remove-hover": {
        "$type": "color",
        "$value": "{color.surface-hover}",
        "$description": "The × button's background under the pointer.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tag-group-remove-hover"
          }
        }
      },
      "remove-pressed": {
        "$type": "color",
        "$value": "{color.pressed}",
        "$description": "The × while it's held down, one step past remove-hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tag-group-remove-pressed"
          }
        }
      },
      "label": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "The group's label.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tag-group-label"
          }
        }
      },
      "muted": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "The empty text.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tag-group-muted"
          }
        }
      },
      "focus-ring": {
        "$type": "color",
        "$value": "{color.focus-ring}",
        "$description": "The focus ring around the focused tag.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tag-group-focus-ring"
          }
        }
      },
      "more": {
        "$type": "color",
        "$value": "{color.primary-text}",
        "$description": "The Show more and Show less button's words (4.5:1 on the page).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tag-group-more"
          }
        }
      },
      "more-hover": {
        "$type": "color",
        "$value": "{color.primary-text-hover}",
        "$description": "The Show more and Show less button's words on hover, as a link's (4.5:1 on the page).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tag-group-more-hover"
          }
        }
      },
      "icon": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "A tag's leading icon (decorative; the words name the tag).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tag-group-icon"
          }
        }
      },
      "border-disabled": {
        "$type": "color",
        "$value": "{color.disabled-border}",
        "$description": "Disabled: the edge.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tag-group-border-disabled"
          }
        }
      },
      "text-disabled": {
        "$type": "color",
        "$value": "{color.disabled-text}",
        "$description": "Disabled: the text, icon or mark, in place of fading it (3:1 or more on its background, more with more contrast).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tag-group-text-disabled"
          }
        }
      }
    },
    "radius": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.radius-control}",
        "$description": "A tag's corners, as other controls'.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tag-group-radius"
          }
        }
      }
    },
    "spacing": {
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "The space between tags (8px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tag-group-gap"
          }
        }
      },
      "label-gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1_5}",
        "$description": "The space between the label and the tags, as between a Field's label and its control (6px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tag-group-label-gap"
          }
        }
      },
      "avatar-size": {
        "$type": "dimension",
        "$value": "{spacing.spacing-6}",
        "$description": "The picture before a tag's words (24px, an xs Avatar's own size, so its initials have room), as tall as the tag.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tag-group-avatar-size"
          }
        }
      },
      "icon-size": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "A tag's icon, the check of a selected tag and the × (16px), beside the 14px label.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tag-group-icon-size"
          }
        }
      }
    }
  }
}
