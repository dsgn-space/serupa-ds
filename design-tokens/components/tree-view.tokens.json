{
  "treeView": {
    "$description": "TreeView's component tokens. Each one is an optional override: set the CSS variable (--tree-view-<name>) on the page, a container or one TreeView, and every TreeView inside follows. Unset, it uses the shared token it references here; tools/test/foundation.mjs checks that bundle.css uses exactly these defaults.",
    "color": {
      "bg": {
        "$type": "color",
        "$value": "{color.surface}",
        "$description": "The background.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tree-view-bg"
          }
        }
      },
      "text": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "The labels (4.5:1 on bg).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tree-view-text"
          }
        }
      },
      "item-bg-hover": {
        "$type": "color",
        "$value": "{color.surface-hover}",
        "$description": "A row's background on hover: zinc-100 in light, like the selected row's.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tree-view-item-bg-hover"
          }
        }
      },
      "item-bg-selected": {
        "$type": "color",
        "$value": "{color.highlight}",
        "$description": "The picked row's background.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tree-view-item-bg-selected"
          }
        }
      },
      "item-indicator": {
        "$type": "color",
        "$value": "{color.highlight-indicator}",
        "$description": "The 2px bar at the picked row's start. Drawn only with more contrast: by default it has no width (`highlight-indicator-width`), and the fill alone marks the item.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tree-view-item-indicator"
          }
        }
      },
      "icon-color": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "The chevrons and item icons.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tree-view-icon-color"
          }
        }
      },
      "focus-ring": {
        "$type": "color",
        "$value": "{color.focus-ring}",
        "$description": "The ring inside the focused row.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tree-view-focus-ring"
          }
        }
      },
      "item-bg-pressed": {
        "$type": "color",
        "$value": "{color.pressed}",
        "$description": "A row's fill while it's held down.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tree-view-item-bg-pressed"
          }
        }
      },
      "text-disabled": {
        "$type": "color",
        "$value": "{color.disabled-text}",
        "$description": "Disabled: the text, icon or mark, in place of fading it (3:1 or more on its background, more with more contrast).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tree-view-text-disabled"
          }
        }
      },
      "check-border": {
        "$type": "color",
        "$value": "{color.field-border}",
        "$description": "With cascade: an unchecked box's border, the soft field border, as Checkbox's.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tree-view-check-border"
          }
        }
      },
      "check-bg": {
        "$type": "color",
        "$value": "{color.field}",
        "$description": "With cascade: an unchecked box's fill.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tree-view-check-bg"
          }
        }
      },
      "check-bg-checked": {
        "$type": "color",
        "$value": "{color.primary}",
        "$description": "With cascade: a checked or mixed box's fill and border (3:1 on the row).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tree-view-check-bg-checked"
          }
        }
      },
      "check-mark": {
        "$type": "color",
        "$value": "{color.on-primary}",
        "$description": "With cascade: the check or dash on a filled box.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tree-view-check-mark"
          }
        }
      }
    },
    "radius": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.radius-control}",
        "$description": "The tree's corners (6px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tree-view-radius"
          }
        }
      },
      "item-radius": {
        "$type": "dimension",
        "$value": "{radius.radius-inner}",
        "$description": "A row's corners (4px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tree-view-item-radius"
          }
        }
      },
      "check-radius": {
        "$type": "dimension",
        "$value": "{radius.radius-inner}",
        "$description": "With cascade: the box's corners.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tree-view-check-radius"
          }
        }
      }
    },
    "spacing": {
      "padding": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1}",
        "$description": "Space inside the tree (4px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tree-view-padding"
          }
        }
      },
      "indent": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "How much further in each level starts (16px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tree-view-indent"
          }
        }
      },
      "item-padding-x": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1}",
        "$description": "Space at a row's start and end (4px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tree-view-item-padding-x"
          }
        }
      },
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1}",
        "$description": "Space between the chevron, icon and label (4px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tree-view-gap"
          }
        }
      }
    },
    "sizing": {
      "item-height": {
        "$type": "dimension",
        "$value": "{sizing.control-height-md}",
        "$description": "A row's least height (32px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tree-view-item-height"
          }
        }
      },
      "check-size": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "With cascade: the box's size (16px), as Checkbox's.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--tree-view-check-size"
          }
        }
      }
    }
  }
}
