{
  "date-picker": {
    "$description": "DatePicker's component tokens. Each one is an optional override: set the CSS variable (--date-picker-<name>) on the page, a container or one picker, and every DatePicker inside follows. Unset, it uses the shared token it references here; tools/test/foundation.mjs checks that bundle.css uses exactly these defaults. The field uses Input's tokens and the calendar Calendar's.",
    "color": {
      "button": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "The calendar button's icon (3:1 on the field).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--date-picker-button"
          }
        }
      },
      "button-hover": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "The calendar button's icon on hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--date-picker-button-hover"
          }
        }
      },
      "button-bg-hover": {
        "$type": "color",
        "$value": "{color.secondary}",
        "$description": "The calendar button's background on hover, as the other buttons inside fields (PasswordInput's show and hide, NumberInput's steps).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--date-picker-button-bg-hover"
          }
        }
      },
      "focus-ring": {
        "$type": "color",
        "$value": "{color.focus-ring}",
        "$description": "The calendar button's keyboard focus ring.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--date-picker-focus-ring"
          }
        }
      },
      "popup-bg": {
        "$type": "color",
        "$value": "{color.surface-overlay}",
        "$description": "The calendar panel's background.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--date-picker-popup-bg"
          }
        }
      },
      "popup-text": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "Text in the calendar panel (the Calendar has its own `--calendar-*` tokens).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--date-picker-popup-text"
          }
        }
      },
      "popup-border": {
        "$type": "color",
        "$value": "{color.border-overlay}",
        "$description": "Its outline.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--date-picker-popup-border"
          }
        }
      }
    },
    "shadow": {
      "popup-shadow": {
        "$type": "shadow",
        "$value": "{shadow.elevation-overlay}",
        "$description": "Its shadow.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--date-picker-popup-shadow"
          }
        }
      },
      "popup-depth": {
        "$type": "shadow",
        "$value": "{shadow.depth-surface}",
        "$description": "The calendar popup's tactile layers, over its shadow: a light along the top edge and a shade along the bottom one. None in the flat brands.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--date-picker-popup-depth"
          }
        }
      }
    },
    "radius": {
      "popup-radius": {
        "$type": "dimension",
        "$value": "{radius.radius-surface}",
        "$description": "Its corners (8px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--date-picker-popup-radius"
          }
        }
      }
    },
    "spacing": {
      "popup-padding": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3}",
        "$description": "Space inside it (12px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--date-picker-popup-padding"
          }
        }
      },
      "offset": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1}",
        "$description": "The gap between the field and the panel (4px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--date-picker-offset"
          }
        }
      }
    },
    "layout": {
      "z-index": {
        "$type": "number",
        "$value": "{layout.z-popover}",
        "$description": "The panel's stacking order, where the top layer isn't available.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--date-picker-z-index"
          }
        }
      }
    }
  }
}
