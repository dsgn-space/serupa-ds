{
  "slider": {
    "$description": "Slider's component tokens. Each one is an optional override: set the CSS variable (--slider-<name>) on the page, a container or one slider, and every Slider inside follows. Unset, it uses the shared token it references here; tools/test/foundation.mjs checks that bundle.css uses exactly these defaults.",
    "color": {
      "track": {
        "$type": "color",
        "$value": "{color.surface-muted}",
        "$description": "The track: a light gray fill, as Meter's and Progress's. The fill and the thumb's ring carry the 3:1.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--slider-track"
          }
        }
      },
      "track-border": {
        "$type": "color",
        "$value": "{color.border}",
        "$description": "The track's edge, inside it: the basic border, as Meter's.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--slider-track-border"
          }
        }
      },
      "fill": {
        "$type": "color",
        "$value": "{color.primary}",
        "$description": "The selected part of the track.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--slider-fill"
          }
        }
      },
      "thumb-bg": {
        "$type": "color",
        "$value": "{color.field}",
        "$description": "The thumb's inside.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--slider-thumb-bg"
          }
        }
      },
      "thumb-border": {
        "$type": "color",
        "$value": "{color.primary}",
        "$description": "The thumb's ring (3:1 on the surface).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--slider-thumb-border"
          }
        }
      },
      "focus-ring": {
        "$type": "color",
        "$value": "{color.focus-ring}",
        "$description": "The thumb's keyboard focus ring.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--slider-focus-ring"
          }
        }
      },
      "invalid": {
        "$type": "color",
        "$value": "{color.danger}",
        "$description": "The fill and the thumb's ring when invalid.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--slider-invalid"
          }
        }
      },
      "mark": {
        "$type": "color",
        "$value": "{color.field}",
        "$description": "The marks' ticks, cut into the track.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--slider-mark"
          }
        }
      },
      "mark-off": {
        "$type": "color",
        "$value": "{color.border-strong}",
        "$description": "A mark's tick past the fill, on the light track.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--slider-mark-off"
          }
        }
      },
      "mark-label": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "The marks' text under the track (4.5:1 on the surface).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--slider-mark-label"
          }
        }
      },
      "value-bg": {
        "$type": "color",
        "$value": "{color.surface-inverse}",
        "$description": "showValue's chip over the thumb.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--slider-value-bg"
          }
        }
      },
      "value-text": {
        "$type": "color",
        "$value": "{color.text-inverse}",
        "$description": "showValue's text (4.5:1 on value-bg).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--slider-value-text"
          }
        }
      },
      "fill-disabled": {
        "$type": "color",
        "$value": "{color.disabled-surface}",
        "$description": "Disabled: the fill, whatever its color when enabled.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--slider-fill-disabled"
          }
        }
      },
      "text-disabled": {
        "$type": "color",
        "$value": "{color.disabled-text}",
        "$description": "Disabled: the text, icon or mark, in place of fading it (3:1 or more on its background, more with more contrast).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--slider-text-disabled"
          }
        }
      }
    },
    "sizing": {
      "track-height-sm": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1}",
        "$description": "The track's thickness, size=\"sm\" (4px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--slider-track-height-sm"
          }
        }
      },
      "track-height-md": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1_5}",
        "$description": "The track's thickness, size=\"md\", the default (6px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--slider-track-height-md"
          }
        }
      },
      "track-height-lg": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "The track's thickness, size=\"lg\" (8px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--slider-track-height-lg"
          }
        }
      },
      "thumb-size-sm": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "The thumb, size=\"sm\" (16px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--slider-thumb-size-sm"
          }
        }
      },
      "thumb-size-md": {
        "$type": "dimension",
        "$value": "{spacing.spacing-5}",
        "$description": "The thumb, size=\"md\" (20px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--slider-thumb-size-md"
          }
        }
      },
      "thumb-size-lg": {
        "$type": "dimension",
        "$value": "{spacing.spacing-6}",
        "$description": "The thumb, size=\"lg\" (24px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--slider-thumb-size-lg"
          }
        }
      },
      "input-width": {
        "$type": "dimension",
        "$value": "{spacing.spacing-20}",
        "$description": "With inputs, each number field's width (80px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--slider-input-width"
          }
        }
      },
      "length": {
        "$type": "dimension",
        "$value": "{spacing.spacing-48}",
        "$description": "A vertical slider's length, along the track (192px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--slider-length"
          }
        }
      },
      "mark-label-gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "The least space between two mark labels; a label that would come closer wraps within its room (8px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--slider-mark-label-gap"
          }
        }
      }
    },
    "borders": {
      "thumb-border-width": {
        "$type": "dimension",
        "$value": "{borders.border-width-2}",
        "$description": "The thumb's ring (2px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--slider-thumb-border-width"
          }
        }
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.radius-pill}",
        "$description": "The track's ends and the thumb.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--slider-radius"
          }
        }
      }
    },
    "shadow": {
      "thumb-shadow": {
        "$type": "shadow",
        "$value": "{shadow.elevation-part}",
        "$description": "The thumb's shadow.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--slider-thumb-shadow"
          }
        }
      }
    },
    "spacing": {
      "input-gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3}",
        "$description": "With inputs, between the track and each number field (12px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--slider-input-gap"
          }
        }
      }
    }
  }
}
