{
  "pagination": {
    "$description": "Pagination's component tokens. Each one is an optional override: set the CSS variable (--pagination-<name>) on the page, a container or one pagination, and everything inside follows. Unset, it uses the shared token it references here; tools/test/foundation.mjs checks that bundle.css uses exactly these defaults.",
    "color": {
      "text": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "A page number and the arrows.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--pagination-text"
          }
        }
      },
      "bg-hover": {
        "$type": "color",
        "$value": "{color.surface-secondary}",
        "$description": "A page or arrow on hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--pagination-bg-hover"
          }
        }
      },
      "bg-pressed": {
        "$type": "color",
        "$value": "{color.surface-secondary-hover}",
        "$description": "A page or arrow while it's pressed, one step past hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--pagination-bg-pressed"
          }
        }
      },
      "bg-current": {
        "$type": "color",
        "$value": "{color.surface-brand}",
        "$description": "The current page's background.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--pagination-bg-current"
          }
        }
      },
      "text-current": {
        "$type": "color",
        "$value": "{color.text-on-brand}",
        "$description": "The current page's number (4.5:1 on current-bg).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--pagination-text-current"
          }
        }
      },
      "ellipsis": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "The … between page ranges (4.5:1 on surface).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--pagination-ellipsis"
          }
        }
      },
      "focus-ring": {
        "$type": "color",
        "$value": "{color.focus-ring}",
        "$description": "The keyboard focus ring.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--pagination-focus-ring"
          }
        }
      },
      "summary": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "The summary with total and pageSize, \"21–30 of 245\" (4.5:1 on surface).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--pagination-summary"
          }
        }
      },
      "text-disabled": {
        "$type": "color",
        "$value": "{color.text-disabled}",
        "$description": "Previous or next when there's no page that way (3:1 or more on the page).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--pagination-text-disabled"
          }
        }
      },
      "edge-current": {
        "$type": "color",
        "$value": "{color.border-brand}",
        "$description": "The current page's 1px edge inside its fill (Yellow Light; transparent where the fill is 3:1 on the page)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--pagination-edge-current"
          }
        }
      }
    },
    "typography": {
      "font-size": {
        "$type": "dimension",
        "$value": "{fontSize.text-sm}",
        "$description": "Page numbers (14px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--pagination-font-size"
          }
        }
      },
      "weight-current": {
        "$type": "fontWeight",
        "$value": "{typography.font-semibold}",
        "$description": "The current page's weight (600).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--pagination-weight-current"
          }
        }
      }
    },
    "sizing": {
      "size": {
        "$type": "dimension",
        "$value": "{sizing.control-height-md}",
        "$description": "A page's width and height at size md (32px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--pagination-size"
          }
        }
      },
      "size-sm": {
        "$type": "dimension",
        "$value": "{sizing.control-height-sm}",
        "$description": "At size sm (24px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--pagination-size-sm"
          }
        }
      },
      "size-lg": {
        "$type": "dimension",
        "$value": "{sizing.control-height-lg}",
        "$description": "At size lg (44px), the touch-target size.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--pagination-size-lg"
          }
        }
      },
      "jump-width": {
        "$type": "dimension",
        "$value": "{spacing.spacing-16}",
        "$description": "The Go to page field, with jump (64px: four digits).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--pagination-jump-width"
          }
        }
      }
    },
    "spacing": {
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1}",
        "$description": "Space between pages (4px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--pagination-gap"
          }
        }
      },
      "padding-x": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "Side padding inside a page, for wide numbers (8px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--pagination-padding-x"
          }
        }
      },
      "padding-x-sm": {
        "$type": "dimension",
        "$value": "{spacing.spacing-0_5}",
        "$description": "At size sm (2px), so two semibold digits fit in the 24px square.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--pagination-padding-x-sm"
          }
        }
      },
      "summary-gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Space between the summary and the pages (16px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--pagination-summary-gap"
          }
        }
      },
      "icon-size-sm": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3_5}",
        "$description": "The arrows at size sm (14px), as an icon-only Button.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--pagination-icon-size-sm"
          }
        }
      },
      "icon-size-md": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "The arrows at size md (16px), as an icon-only Button.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--pagination-icon-size-md"
          }
        }
      },
      "icon-size-lg": {
        "$type": "dimension",
        "$value": "{spacing.spacing-5}",
        "$description": "The arrows at size lg (20px), as an icon-only Button.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--pagination-icon-size-lg"
          }
        }
      }
    },
    "radius": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.radius-control}",
        "$description": "A page's corners (6px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--pagination-radius"
          }
        }
      }
    }
  }
}
