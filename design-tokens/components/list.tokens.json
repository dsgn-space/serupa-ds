{
  "list": {
    "$description": "List's component tokens. Each one is an optional override: set the CSS variable (--list-<name>) on the page, a container or one list, and everything inside follows. Unset, it uses the shared token it references here; tools/test/foundation.mjs checks that bundle.css uses exactly these defaults.",
    "color": {
      "border": {
        "$type": "color",
        "$value": "{color.border}",
        "$description": "Lines between items, and the frame of variant=\"card\".",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--list-border"
          }
        }
      },
      "bg": {
        "$type": "color",
        "$value": "{color.surface}",
        "$description": "The background of variant=\"card\".",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--list-bg"
          }
        }
      },
      "title": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "An item's title.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--list-title-color"
          }
        }
      },
      "description": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "An item's description (4.5:1 on bg and bg-hover).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--list-description-color"
          }
        }
      },
      "text-muted-shaded": {
        "$type": "color",
        "$value": "{color.text-muted-shaded}",
        "$description": "Grey text (descriptions, trailing text, a leading icon) in a hovered or selected item, where `text-muted` would fall under 4.5:1 on the shaded fill.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--list-text-muted-shaded"
          }
        }
      },
      "avatar-bg-shaded": {
        "$type": "color",
        "$value": "{color.secondary-hover}",
        "$description": "An Avatar's fill in a hovered or selected item: one step up, since in light themes `secondary`, its usual fill, is the same zinc-100 as the shade.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--list-avatar-bg-shaded"
          }
        }
      },
      "bg-hover": {
        "$type": "color",
        "$value": "{color.surface-hover}",
        "$description": "A link or button item on hover, and a selected item.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--list-bg-hover"
          }
        }
      },
      "bg-pressed": {
        "$type": "color",
        "$value": "{color.pressed}",
        "$description": "A link or button item while it's pressed (not while its trailing action is), one step past hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--list-bg-pressed"
          }
        }
      },
      "indicator-selected": {
        "$type": "color",
        "$value": "{color.highlight-indicator}",
        "$description": "The bar at the start of a selected item. Drawn only with more contrast: by default it has no width (`highlight-indicator-width`), and the fill alone marks the item.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--list-indicator-selected"
          }
        }
      },
      "focus-ring": {
        "$type": "color",
        "$value": "{color.focus-ring}",
        "$description": "The keyboard focus ring.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--list-focus-ring"
          }
        }
      },
      "text-disabled": {
        "$type": "color",
        "$value": "{color.disabled-text}",
        "$description": "Disabled: the text, icon or mark, in place of fading it (3:1 or more on its background, more with more contrast).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--list-text-disabled"
          }
        }
      }
    },
    "typography": {
      "title-size": {
        "$type": "dimension",
        "$value": "{fontSize.text-sm}",
        "$description": "Titles (14px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--list-title-size"
          }
        }
      },
      "title-weight": {
        "$type": "fontWeight",
        "$value": "{typography.font-medium}",
        "$description": "Title weight (500).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--list-title-weight"
          }
        }
      },
      "description-size": {
        "$type": "dimension",
        "$value": "{fontSize.text-sm}",
        "$description": "Descriptions (14px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--list-description-size"
          }
        }
      }
    },
    "spacing": {
      "padding-x": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3}",
        "$description": "An item's side padding (12px; variant=\"card\": padding-x-card).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--list-padding-x"
          }
        }
      },
      "padding-x-card": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "An item's side padding in variant=\"card\" (16px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--list-padding-x-card"
          }
        }
      },
      "padding-y": {
        "$type": "dimension",
        "$value": "{spacing.space-row}",
        "$description": "An item's top and bottom padding: 12px, 6px in the compact density.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--list-padding-y"
          }
        }
      },
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3}",
        "$description": "Space between the leading element, the text and the trailing element (12px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--list-gap"
          }
        }
      }
    },
    "border": {
      "border-width": {
        "$type": "dimension",
        "$value": "{borders.border-width-1}",
        "$description": "Lines and frame (1px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--list-border-width"
          }
        }
      },
      "indicator-width": {
        "$type": "dimension",
        "$value": "{borders.highlight-indicator-width}",
        "$description": "The width of the selected item's bar: none by default, 2px with more contrast.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--list-indicator-width"
          }
        }
      }
    },
    "radius": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.radius-surface}",
        "$description": "The corners of variant=\"card\" (8px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--list-radius"
          }
        }
      }
    }
  }
}
