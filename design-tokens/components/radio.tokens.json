{
  "radio": {
    "$description": "Radio's and RadioGroup's component tokens. Each one is an optional override: set the CSS variable (--radio-<name>) on the page, a container or one radio, and every Radio inside follows. Unset, it uses the shared token it references here; tools/test/foundation.mjs checks that bundle.css uses exactly these defaults.",
    "color": {
      "bg": {
        "$type": "color",
        "$value": "{color.field}",
        "$description": "The circle while unchecked",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-bg"
          }
        }
      },
      "bg-disabled": {
        "$type": "color",
        "$value": "{color.surface-muted}",
        "$description": "The circle when disabled and unchecked",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-bg-disabled"
          }
        }
      },
      "bg-checked": {
        "$type": "color",
        "$value": "{color.primary}",
        "$description": "Fill and border when checked",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-bg-checked"
          }
        }
      },
      "bg-checked-hover": {
        "$type": "color",
        "$value": "{color.primary-hover}",
        "$description": "The same, on hover",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-bg-checked-hover"
          }
        }
      },
      "border": {
        "$type": "color",
        "$value": "{color.field-border}",
        "$description": "Border while unchecked",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-border"
          }
        }
      },
      "border-hover": {
        "$type": "color",
        "$value": "{color.field-border-hover}",
        "$description": "Border on hover",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-border-hover"
          }
        }
      },
      "dot-color": {
        "$type": "color",
        "$value": "{color.on-primary}",
        "$description": "The dot",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-dot-color"
          }
        }
      },
      "label-color": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "The label",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-label-color"
          }
        }
      },
      "description-color": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "The description",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-description-color"
          }
        }
      },
      "focus-ring": {
        "$type": "color",
        "$value": "{color.focus-ring}",
        "$description": "The focus ring",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-focus-ring"
          }
        }
      },
      "invalid": {
        "$type": "color",
        "$value": "{color.field-border-invalid}",
        "$description": "Border and focus ring when invalid",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-invalid"
          }
        }
      },
      "card-bg": {
        "$type": "color",
        "$value": "{color.surface}",
        "$description": "A card radio's background.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-card-bg"
          }
        }
      },
      "card-border": {
        "$type": "color",
        "$value": "{color.border}",
        "$description": "A card's border.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-card-border"
          }
        }
      },
      "card-border-hover": {
        "$type": "color",
        "$value": "{color.field-border-hover}",
        "$description": "A card's border under the pointer.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-card-border-hover"
          }
        }
      },
      "card-border-checked": {
        "$type": "color",
        "$value": "{color.primary}",
        "$description": "A checked card's border, 2px.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-card-border-checked"
          }
        }
      }
    },
    "sizing": {
      "size-sm": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3_5}",
        "$description": "Circle size, sm (14px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-size-sm"
          }
        }
      },
      "size-md": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Circle size, md (16px, default).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-size-md"
          }
        }
      },
      "size-lg": {
        "$type": "dimension",
        "$value": "{spacing.spacing-5}",
        "$description": "Circle size, lg (20px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-size-lg"
          }
        }
      },
      "dot-size-sm": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1_5}",
        "$description": "Dot size, sm (6px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-dot-size-sm"
          }
        }
      },
      "dot-size-md": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1_5}",
        "$description": "Dot size, md (6px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-dot-size-md"
          }
        }
      },
      "dot-size-lg": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "Dot size, lg (8px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-dot-size-lg"
          }
        }
      },
      "card-min-width": {
        "$type": "dimension",
        "$value": "{spacing.spacing-48}",
        "$description": "The narrowest a card gets in a horizontal group before the row wraps (192px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-card-min-width"
          }
        }
      }
    },
    "spacing": {
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "Circle to label (8px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-gap"
          }
        }
      },
      "group-gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "Between radios in a stack, and between rows (8px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-group-gap"
          }
        }
      },
      "group-gap-horizontal": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Between radios in a row (16px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-group-gap-horizontal"
          }
        }
      },
      "card-padding": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Space inside a card (16px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-card-padding"
          }
        }
      },
      "card-gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3}",
        "$description": "Space between a card's radio and its text (12px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-card-gap"
          }
        }
      },
      "card-group-gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3}",
        "$description": "Space between cards in a group (12px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-card-group-gap"
          }
        }
      }
    },
    "typography": {
      "card-label-weight": {
        "$type": "fontWeight",
        "$value": "{typography.font-medium}",
        "$description": "A card's label weight (500).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-card-label-weight"
          }
        }
      }
    },
    "border": {
      "border-width": {
        "$type": "dimension",
        "$value": "{borders.border-width-1}",
        "$description": "Border width (1px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-border-width"
          }
        }
      }
    },
    "radius": {
      "card-radius": {
        "$type": "dimension",
        "$value": "{radius.radius-surface}",
        "$description": "A card's corners (8px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-card-radius"
          }
        }
      }
    },
    "motion": {
      "press-scale": {
        "$type": "number",
        "$value": "{transforms.scale-90}",
        "$description": "Size of the circle while it's held down (90%). 1 turns it off",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-press-scale"
          }
        }
      }
    },
    "shadow": {
      "depth": {
        "$type": "shadow",
        "$value": "{shadow.depth-well}",
        "$description": "The circle's tactile layers while unselected: sunk into the page. None in the flat brands.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-depth"
          }
        }
      },
      "depth-checked": {
        "$type": "shadow",
        "$value": "{shadow.depth-part}",
        "$description": "The circle's tactile layers once selected: raised, with a highlight along the top. None in the flat brands.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-depth-checked"
          }
        }
      }
    }
  }
}
