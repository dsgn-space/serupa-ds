{
  "radio": {
    "$description": "Radio's and RadioGroup's component tokens. Each one is an optional override: set the CSS variable (--radio-<name>) on the page, a container or one radio, and every Radio inside follows. Unset, it uses the shared token it references here; tools/test/foundation.mjs checks that bundle.css uses exactly these defaults.",
    "color": {
      "bg": {
        "$type": "color",
        "$value": "{color.field}",
        "$description": "The circle while unchecked",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-bg"
          }
        }
      },
      "bg-disabled": {
        "$type": "color",
        "$value": "{color.field-readonly}",
        "$description": "The circle when disabled and unchecked: a disabled field's fill, at or above the surface in dark rather than sunk below it",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-bg-disabled"
          }
        }
      },
      "bg-checked": {
        "$type": "color",
        "$value": "{color.primary}",
        "$description": "Fill and border when checked",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-bg-checked"
          }
        }
      },
      "bg-checked-hover": {
        "$type": "color",
        "$value": "{color.primary-hover}",
        "$description": "The same, on hover",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-bg-checked-hover"
          }
        }
      },
      "bg-checked-pressed": {
        "$type": "color",
        "$value": "{color.primary-pressed}",
        "$description": "The checked circle's fill while held down, one step past bg-checked-hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-bg-checked-pressed"
          }
        }
      },
      "bg-pressed": {
        "$type": "color",
        "$value": "{color.secondary}",
        "$description": "The unchecked circle's background while held down.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-bg-pressed"
          }
        }
      },
      "border": {
        "$type": "color",
        "$value": "{color.field-border}",
        "$description": "Border while unchecked",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-border"
          }
        }
      },
      "border-hover": {
        "$type": "color",
        "$value": "{color.field-border-hover}",
        "$description": "Border on hover",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-border-hover"
          }
        }
      },
      "border-pressed": {
        "$type": "color",
        "$value": "{color.field-border-pressed}",
        "$description": "The unchecked circle's border while held down, one step past border-hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-border-pressed"
          }
        }
      },
      "dot-color": {
        "$type": "color",
        "$value": "{color.on-primary}",
        "$description": "The dot",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-dot-color"
          }
        }
      },
      "label-color": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "The label",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-label-color"
          }
        }
      },
      "description-color": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "The description",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-description-color"
          }
        }
      },
      "focus-ring": {
        "$type": "color",
        "$value": "{color.focus-ring}",
        "$description": "The focus ring",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-focus-ring"
          }
        }
      },
      "invalid": {
        "$type": "color",
        "$value": "{color.field-border-invalid}",
        "$description": "Border and focus ring when invalid",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-invalid"
          }
        }
      },
      "card-bg": {
        "$type": "color",
        "$value": "{color.surface}",
        "$description": "A card radio's background.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-card-bg"
          }
        }
      },
      "card-border": {
        "$type": "color",
        "$value": "{color.border}",
        "$description": "A card's border.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-card-border"
          }
        }
      },
      "card-border-hover": {
        "$type": "color",
        "$value": "{color.field-border-hover}",
        "$description": "A card's border under the pointer.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-card-border-hover"
          }
        }
      },
      "card-border-checked": {
        "$type": "color",
        "$value": "{color.primary-text}",
        "$description": "A checked card's border, 2px.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-card-border-checked"
          }
        }
      },
      "border-disabled": {
        "$type": "color",
        "$value": "{color.disabled-border}",
        "$description": "Disabled: the edge.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-border-disabled"
          }
        }
      },
      "fill-disabled": {
        "$type": "color",
        "$value": "{color.disabled-surface}",
        "$description": "Disabled: the fill, whatever its color when enabled.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-fill-disabled"
          }
        }
      },
      "text-disabled": {
        "$type": "color",
        "$value": "{color.disabled-text}",
        "$description": "Disabled: the text, icon or mark, in place of fading it (3:1 or more on its background, more with more contrast).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-text-disabled"
          }
        }
      }
    },
    "sizing": {
      "size-sm": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3_5}",
        "$description": "Circle size, sm (14px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-size-sm"
          }
        }
      },
      "size-md": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Circle size, md (16px, default).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-size-md"
          }
        }
      },
      "size-lg": {
        "$type": "dimension",
        "$value": "{spacing.spacing-5}",
        "$description": "Circle size, lg (20px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-size-lg"
          }
        }
      },
      "dot-size-sm": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1_5}",
        "$description": "Dot size, sm (6px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-dot-size-sm"
          }
        }
      },
      "dot-size-md": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1_5}",
        "$description": "Dot size, md (6px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-dot-size-md"
          }
        }
      },
      "dot-size-lg": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "Dot size, lg (8px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-dot-size-lg"
          }
        }
      },
      "card-min-width": {
        "$type": "dimension",
        "$value": "{spacing.spacing-48}",
        "$description": "The narrowest a card gets in a horizontal group before the row wraps (192px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-card-min-width"
          }
        }
      }
    },
    "spacing": {
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "Circle to label (8px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-gap"
          }
        }
      },
      "group-gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "Between radios in a stack, and between rows (8px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-group-gap"
          }
        }
      },
      "group-gap-horizontal": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Between radios in a row (16px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-group-gap-horizontal"
          }
        }
      },
      "card-padding": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Space inside a card (16px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-card-padding"
          }
        }
      },
      "card-gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3}",
        "$description": "Space between a card's radio and its text (12px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-card-gap"
          }
        }
      },
      "card-group-gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3}",
        "$description": "Space between cards in a group (12px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-card-group-gap"
          }
        }
      }
    },
    "typography": {
      "card-label-weight": {
        "$type": "fontWeight",
        "$value": "{typography.font-medium}",
        "$description": "A card's label weight (500).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-card-label-weight"
          }
        }
      }
    },
    "border": {
      "border-width": {
        "$type": "dimension",
        "$value": "{borders.border-width-1}",
        "$description": "Border width (1px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-border-width"
          }
        }
      }
    },
    "radius": {
      "card-radius": {
        "$type": "dimension",
        "$value": "{radius.radius-surface}",
        "$description": "A card's corners (8px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-card-radius"
          }
        }
      }
    },
    "motion": {
      "press-scale": {
        "$type": "number",
        "$value": "{transforms.scale-100}",
        "$description": "Size of the circle while it's held down. 100%: off by default, since a press shows as the held colors (bg-pressed, border-pressed, bg-checked-pressed). Set it, e.g. to `var(--scale-90)`, to add a shrink.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--radio-press-scale"
          }
        }
      }
    }
  }
}
