{
  "input": {
    "$description": "Input's component tokens. Each one is an optional override: set the CSS variable (--input-<name>) on the page, a container or one input, and every Input inside follows. Unset, it uses the shared token it references here; tools/test/foundation.mjs checks that bundle.css uses exactly these defaults.",
    "color": {
      "bg": {
        "$type": "color",
        "$value": "{color.field}",
        "$description": "Background",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-bg"
          }
        }
      },
      "bg-readonly": {
        "$type": "color",
        "$value": "{color.field-readonly}",
        "$description": "Background when read-only or disabled",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-bg-readonly"
          }
        }
      },
      "text": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "The typed text",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-text"
          }
        }
      },
      "border": {
        "$type": "color",
        "$value": "{color.field-border}",
        "$description": "Border",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-border"
          }
        }
      },
      "border-hover": {
        "$type": "color",
        "$value": "{color.field-border-hover}",
        "$description": "Border on hover",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-border-hover"
          }
        }
      },
      "placeholder": {
        "$type": "color",
        "$value": "{color.placeholder}",
        "$description": "Placeholder text",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-placeholder"
          }
        }
      },
      "icon-color": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "Left and right icons",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-icon-color"
          }
        }
      },
      "affix": {
        "$type": "color",
        "$value": "{color.placeholder}",
        "$description": "The `prefix` and `suffix` text",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-affix"
          }
        }
      },
      "count": {
        "$type": "color",
        "$value": "{color.placeholder}",
        "$description": "The character count",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-count"
          }
        }
      },
      "count-full": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "The count once `maxLength` is reached",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-count-full"
          }
        }
      },
      "focus-ring": {
        "$type": "color",
        "$value": "{color.focus-ring}",
        "$description": "Border and ring while focused",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-focus-ring"
          }
        }
      },
      "invalid": {
        "$type": "color",
        "$value": "{color.danger}",
        "$description": "Border and ring when invalid",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-invalid"
          }
        }
      },
      "action": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "An icon action's icon (3:1 on the field).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-action"
          }
        }
      },
      "action-hover": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "An icon action's icon on hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-action-hover"
          }
        }
      },
      "action-bg-hover": {
        "$type": "color",
        "$value": "{color.secondary}",
        "$description": "An icon action's background on hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-action-bg-hover"
          }
        }
      },
      "action-bg-pressed": {
        "$type": "color",
        "$value": "{color.secondary-hover}",
        "$description": "An icon action's background while it's held down, one step past hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-action-bg-pressed"
          }
        }
      },
      "action-text": {
        "$type": "color",
        "$value": "{color.primary}",
        "$description": "A text action's words, such as Apply (4.5:1 on the field).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-action-text"
          }
        }
      },
      "action-text-bg-hover": {
        "$type": "color",
        "$value": "{color.primary-subtle}",
        "$description": "A text action's background on hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-action-text-bg-hover"
          }
        }
      },
      "action-focus-ring": {
        "$type": "color",
        "$value": "{color.focus-ring}",
        "$description": "The ring around a focused action.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-action-focus-ring"
          }
        }
      },
      "rejected-color": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "The line under a DatePicker, DateRangePicker, TimePicker or NumberInput saying why typed text was put back.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-rejected-color"
          }
        }
      }
    },
    "sizing": {
      "height-sm": {
        "$type": "dimension",
        "$value": "{sizing.control-height-sm}",
        "$description": "Height, sm (24px), like Button sm.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-height-sm"
          }
        }
      },
      "height-md": {
        "$type": "dimension",
        "$value": "{sizing.control-height-md}",
        "$description": "Height, md (32px, default).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-height-md"
          }
        }
      },
      "height-lg": {
        "$type": "dimension",
        "$value": "{sizing.control-height-lg}",
        "$description": "Height, lg (44px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-height-lg"
          }
        }
      },
      "icon-size-sm": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3_5}",
        "$description": "Icon size, sm (14px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-icon-size-sm"
          }
        }
      },
      "icon-size-md": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Icon size, md (16px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-icon-size-md"
          }
        }
      },
      "icon-size-lg": {
        "$type": "dimension",
        "$value": "{spacing.spacing-5}",
        "$description": "Icon size, lg (20px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-icon-size-lg"
          }
        }
      }
    },
    "spacing": {
      "padding-x-sm": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "Side padding, sm (8px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-padding-x-sm"
          }
        }
      },
      "padding-x-md": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3}",
        "$description": "Side padding, md (12px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-padding-x-md"
          }
        }
      },
      "padding-x-lg": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Side padding, lg (16px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-padding-x-lg"
          }
        }
      },
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "Gap between an icon and the text (8px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-gap"
          }
        }
      },
      "actions-inset": {
        "$type": "dimension",
        "$value": "{spacing.spacing-0_5}",
        "$description": "Space between the actions and the box's edge (2px), so an action is the field's height less 6px.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-actions-inset"
          }
        }
      },
      "action-padding-x": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "Space at a text action's sides (8px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-action-padding-x"
          }
        }
      }
    },
    "border": {
      "border-width": {
        "$type": "dimension",
        "$value": "{borders.border-width-1}",
        "$description": "Border width (1px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-border-width"
          }
        }
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.radius-control}",
        "$description": "Corner radius (6px), like Button and Badge",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-radius"
          }
        }
      },
      "action-radius": {
        "$type": "dimension",
        "$value": "{radius.radius-inner}",
        "$description": "An action's corners (4px), inside the box's.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-action-radius"
          }
        }
      }
    },
    "shadow": {
      "depth": {
        "$type": "shadow",
        "$value": "{shadow.depth-field}",
        "$description": "The tactile inner shade along the top of the box. None in the flat brands.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--input-depth"
          }
        }
      }
    }
  }
}
