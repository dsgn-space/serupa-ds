{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Dependabot's rules from .github/dependabot.yml, for GitLab: a release only once it is 7 days old, grouped, a few merge requests at a time. Dev tools merge themselves when the pipeline passes; a dependency the package ships waits for a person and a changeset.",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 1,
  "rangeStrategy": "pin",
  "rebaseWhen": "conflicted",
  "dependencyDashboard": false,
  "labels": ["dependencies"],
  "packageRules": [
    { "matchPackageNames": ["storybook", "@storybook/**"], "groupName": "storybook" },
    { "matchPackageNames": ["vitest", "@vitest/**", "vitest-browser-react", "vite"], "groupName": "vitest" },
    { "matchPackageNames": ["eslint", "@eslint/**", "eslint-plugin-*", "typescript-eslint", "globals", "stylelint", "stylelint-*"], "groupName": "lint" },
    { "matchDepTypes": ["devDependencies"], "matchUpdateTypes": ["minor", "patch"], "groupName": "dev tools (minor and patch)", "addLabels": ["no-changeset"], "automerge": true, "platformAutomerge": true },
    { "matchDepTypes": ["devDependencies"], "matchUpdateTypes": ["major"], "addLabels": ["no-changeset"] },
    { "matchManagers": ["gitlabci"], "pinDigests": true, "groupName": "CI images", "addLabels": ["no-changeset"] },
    { "description": "What the package asks of a project (peerDependencies, engines) stays a range: pinned, it would refuse every other React 19 or Node release.", "matchDepTypes": ["peerDependencies", "engines"], "rangeStrategy": "widen" },
    { "description": ".nvmrc names the Node major (26) on purpose; tools/setup.mjs picks its latest release.", "matchManagers": ["nvm"], "matchUpdateTypes": ["pin"], "enabled": false }
  ]
}
