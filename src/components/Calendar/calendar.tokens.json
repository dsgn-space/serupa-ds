{
  "calendar": {
    "$description": "Calendar's component tokens (also used by DatePicker). Each one is an optional override: set the CSS variable (--calendar-<name>) on the page, a container or one calendar, and every Calendar inside follows. Unset, it uses the shared token it references here; tools/test/foundation.mjs checks that bundle.css uses exactly these defaults.",
    "color": {
      "title-color": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "The month and year.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--calendar-title-color"
          }
        }
      },
      "menu-border": {
        "$type": "color",
        "$value": "{color.field-border}",
        "$description": "The Month and Year menus' border (`monthYearPicker`).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--calendar-menu-border"
          }
        }
      },
      "menu-bg": {
        "$type": "color",
        "$value": "{color.field}",
        "$description": "The Month and Year menus' fill (`monthYearPicker`).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--calendar-menu-bg"
          }
        }
      },
      "presets-border": {
        "$type": "color",
        "$value": "{color.border}",
        "$description": "The line between the days and the `presets` shortcuts.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--calendar-presets-border"
          }
        }
      },
      "weekday-color": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "The weekday names (4.5:1 on surface).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--calendar-weekday-color"
          }
        }
      },
      "week-color": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "The week numbers, with weekNumbers (4.5:1 on surface).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--calendar-week-color"
          }
        }
      },
      "day-color": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "Days of the shown month.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--calendar-day-color"
          }
        }
      },
      "outside-color": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "Days of the months before and after.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--calendar-outside-color"
          }
        }
      },
      "outside-color-hover": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "A day of the months before and after, under the pointer: full text, so it keeps 4.5:1 on the hover fill.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--calendar-outside-color-hover"
          }
        }
      },
      "day-bg-hover": {
        "$type": "color",
        "$value": "{color.surface-secondary}",
        "$description": "A day or preset under the pointer, as Pagination's pages.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--calendar-day-bg-hover"
          }
        }
      },
      "day-bg-pressed": {
        "$type": "color",
        "$value": "{color.surface-secondary-hover}",
        "$description": "A day while it's pressed, one step past hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--calendar-day-bg-pressed"
          }
        }
      },
      "today-color": {
        "$type": "color",
        "$value": "{color.text-brand}",
        "$description": "Today's number (4.5:1 on surface).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--calendar-today-color"
          }
        }
      },
      "today-color-hover": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "Today's number under the pointer: full text, as primary drops under 4.5:1 on the hover fill in dark.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--calendar-today-color-hover"
          }
        }
      },
      "bg-selected": {
        "$type": "color",
        "$value": "{color.surface-brand}",
        "$description": "The selected day.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--calendar-bg-selected"
          }
        }
      },
      "color-selected": {
        "$type": "color",
        "$value": "{color.text-on-brand}",
        "$description": "Its number.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--calendar-color-selected"
          }
        }
      },
      "range-bg": {
        "$type": "color",
        "$value": "{color.surface-brand-subtle}",
        "$description": "Days between the start and end of a range (DateRangePicker).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--calendar-range-bg"
          }
        }
      },
      "range-color": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "Their numbers (4.5:1 on range-bg).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--calendar-range-color"
          }
        }
      },
      "focus-ring": {
        "$type": "color",
        "$value": "{color.focus-ring}",
        "$description": "A day's keyboard focus ring.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--calendar-focus-ring"
          }
        }
      },
      "text-disabled": {
        "$type": "color",
        "$value": "{color.text-disabled}",
        "$description": "Disabled: the text, icon or mark, in place of fading it (3:1 or more on its background, more with more contrast).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--calendar-text-disabled"
          }
        }
      },
      "edge-selected": {
        "$type": "color",
        "$value": "{color.border-brand}",
        "$description": "The selected day's 1px edge inside its fill (Yellow Light; transparent where the fill is 3:1 on the page)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--calendar-edge-selected"
          }
        }
      }
    },
    "sizing": {
      "day-size": {
        "$type": "dimension",
        "$value": "{sizing.control-height-md}",
        "$description": "Each day's square (32px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--calendar-day-size"
          }
        }
      },
      "week-width": {
        "$type": "dimension",
        "$value": "{spacing.spacing-7}",
        "$description": "The week number column, with weekNumbers (28px); the days give up its width on a narrow screen.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--calendar-week-width"
          }
        }
      }
    },
    "radius": {
      "day-radius": {
        "$type": "dimension",
        "$value": "{radius.radius-control}",
        "$description": "A day's corners (6px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--calendar-day-radius"
          }
        }
      }
    },
    "spacing": {
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "Space between the header and the days (8px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--calendar-gap"
          }
        }
      },
      "row-gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1}",
        "$description": "Space between the weeks (4px), so the rows read apart and a range is a band per week; the month and year grids keep the same height.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--calendar-row-gap"
          }
        }
      }
    },
    "typography": {
      "title-weight": {
        "$type": "fontWeight",
        "$value": "{typography.font-semibold}",
        "$description": "The month and year (600).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--calendar-title-weight"
          }
        }
      },
      "today-weight": {
        "$type": "fontWeight",
        "$value": "{typography.font-normal}",
        "$description": "Today's number: the weight of every day (400); its color sets it apart.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--calendar-today-weight"
          }
        }
      }
    }
  }
}
