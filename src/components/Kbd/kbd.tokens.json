{
  "kbd": {
    "$description": "Kbd's component tokens. Each one is an optional override: set the CSS variable (--kbd-<name>) on the page, a container or one key, and every Kbd inside follows. Unset, it uses the shared token it references here; tools/test/foundation.mjs checks that bundle.css uses exactly these defaults.",
    "color": {
      "bg": {
        "$type": "color",
        "$value": "{color.surface-muted}",
        "$description": "A key's background.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--kbd-bg"
          }
        }
      },
      "border": {
        "$type": "color",
        "$value": "{color.border-control}",
        "$description": "A key's outline, thicker at the bottom like a keycap.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--kbd-border"
          }
        }
      },
      "text": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "The key's label (4.5:1 on bg).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--kbd-text"
          }
        }
      },
      "separator": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "The + between keys in a combination.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--kbd-separator"
          }
        }
      },
      "border-sm": {
        "$type": "color",
        "$value": "{color.border}",
        "$description": "size=\"sm\"'s outline, quieter, for a key inside a control such as a search button.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--kbd-border-sm"
          }
        }
      }
    },
    "radius": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.radius-inner}",
        "$description": "A key's corners (4px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--kbd-radius"
          }
        }
      }
    },
    "sizing": {
      "height-sm": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "size=\"sm\" (16px), for a key inside a control such as a search button.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--kbd-height-sm"
          }
        }
      },
      "height-md": {
        "$type": "dimension",
        "$value": "{spacing.spacing-5}",
        "$description": "size=\"md\", the default (20px): the one height wherever text is around the key.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--kbd-height-md"
          }
        }
      }
    },
    "spacing": {
      "padding-x": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1_5}",
        "$description": "Space on each side of a word such as Esc (6px). A one-character key is square instead.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--kbd-padding-x"
          }
        }
      },
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1}",
        "$description": "Space between keys and the + in a combination (4px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--kbd-gap"
          }
        }
      },
      "padding-x-sm": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1}",
        "$description": "size=\"sm\"'s space on each side of a word (4px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--kbd-padding-x-sm"
          }
        }
      },
      "gap-sm": {
        "$type": "dimension",
        "$value": "{spacing.spacing-0_5}",
        "$description": "size=\"sm\"'s space between keys, which has no + (2px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--kbd-gap-sm"
          }
        }
      }
    },
    "border": {
      "bottom-width": {
        "$type": "dimension",
        "$value": "{borders.border-width-2}",
        "$description": "A key's bottom edge, thicker like a keycap's (2px; sm uses 1px all round).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--kbd-border-bottom-width"
          }
        }
      }
    }
  }
}
