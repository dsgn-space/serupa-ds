{
  "table": {
    "$description": "Table's component tokens. Each one is an optional override: set the CSS variable (--table-<name>) on the page, a container or one table, and everything inside follows. Unset, it uses the shared token it references here; tools/test/foundation.mjs checks that bundle.css uses exactly these defaults.",
    "color": {
      "bg": {
        "$type": "color",
        "$value": "{color.surface}",
        "$description": "The table's background.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--table-bg"
          }
        }
      },
      "text": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "Cell text.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--table-text"
          }
        }
      },
      "border": {
        "$type": "color",
        "$value": "{color.border}",
        "$description": "The frame and the lines between rows.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--table-border"
          }
        }
      },
      "header-bg": {
        "$type": "color",
        "$value": "{color.surface-muted}",
        "$description": "The header row's background.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--table-header-bg"
          }
        }
      },
      "header-text": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "Header text (4.5:1 on header-bg).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--table-header-text"
          }
        }
      },
      "text-muted-shaded": {
        "$type": "color",
        "$value": "{color.text-muted-shaded}",
        "$description": "Grey text in a hovered, striped or selected row, where `text-muted` would fall under 4.5:1 on the shaded fill; it reaches muted text in your cells too.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--table-text-muted-shaded"
          }
        }
      },
      "avatar-bg-shaded": {
        "$type": "color",
        "$value": "{color.secondary-hover}",
        "$description": "An Avatar's fill in a hovered, striped or selected row: one step up, since in light themes `secondary`, its usual fill, is the same zinc-100 as the shade.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--table-avatar-bg-shaded"
          }
        }
      },
      "row-bg-hover": {
        "$type": "color",
        "$value": "{color.surface-hover}",
        "$description": "A body row on hover, and every other row when striped (muted text keeps 4.5:1).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--table-row-bg-hover"
          }
        }
      },
      "row-bg-pressed": {
        "$type": "color",
        "$value": "{color.pressed}",
        "$description": "A linked row's background while it is held down, a step past its hover, as a List row's.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--table-row-bg-pressed"
          }
        }
      },
      "row-bg-selected": {
        "$type": "color",
        "$value": "{color.surface-hover}",
        "$description": "A selected row's background.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--table-row-bg-selected"
          }
        }
      },
      "row-indicator-selected": {
        "$type": "color",
        "$value": "{color.highlight-indicator}",
        "$description": "The bar at the start of a selected row. Drawn only with more contrast: by default it has no width (`highlight-indicator-width`), and the fill alone marks the item.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--table-row-indicator-selected"
          }
        }
      },
      "focus-ring": {
        "$type": "color",
        "$value": "{color.focus-ring}",
        "$description": "The keyboard focus ring (sort buttons, a scrolling table).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--table-focus-ring"
          }
        }
      },
      "sort-bg-pressed": {
        "$type": "color",
        "$value": "{color.pressed}",
        "$description": "A sortable header's fill while it's held down.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--table-sort-bg-pressed"
          }
        }
      },
      "action-bar-bg": {
        "$type": "color",
        "$value": "{color.primary-subtle}",
        "$description": "TableActionBar's background.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--table-action-bar-bg"
          }
        }
      },
      "action-bar-text": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "TableActionBar's count (4.5:1 on its background).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--table-action-bar-text"
          }
        }
      },
      "resize-active": {
        "$type": "color",
        "$value": "{color.primary-text}",
        "$description": "A column's resize handle on hover, while dragged and on focus.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--table-resize-active"
          }
        }
      }
    },
    "shadow": {
      "head-scrolled": {
        "$type": "shadow",
        "$value": "{shadow.elevation-part}",
        "$description": "A sticky header's shadow once rows have scrolled under it (where scroll-state container queries are supported).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--table-head-shadow-scrolled"
          }
        }
      },
      "pin-scrolled": {
        "$type": "shadow",
        "$value": "{shadow.elevation-part}",
        "$description": "A pinned column's shadow on its inner edge while there's more to scroll to under it (where scroll-state container queries are supported).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--table-pin-shadow-scrolled"
          }
        }
      }
    },
    "typography": {
      "font-size": {
        "$type": "dimension",
        "$value": "{fontSize.text-sm}",
        "$description": "Cell text (14px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--table-font-size"
          }
        }
      },
      "header-weight": {
        "$type": "fontWeight",
        "$value": "{typography.font-medium}",
        "$description": "Header text weight (500).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--table-header-weight"
          }
        }
      },
      "action-bar-weight": {
        "$type": "fontWeight",
        "$value": "{typography.font-semibold}",
        "$description": "TableActionBar's count.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--table-action-bar-weight"
          }
        }
      }
    },
    "spacing": {
      "padding-x": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3}",
        "$description": "A cell's side padding (12px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--table-padding-x"
          }
        }
      },
      "padding-y": {
        "$type": "dimension",
        "$value": "{spacing.space-row}",
        "$description": "A cell's top and bottom padding at size md: 12px, 6px in the compact density.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--table-padding-y"
          }
        }
      },
      "padding-y-sm": {
        "$type": "dimension",
        "$value": "{spacing.space-item}",
        "$description": "At size sm: 8px, 4px in the compact density.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--table-padding-y-sm"
          }
        }
      },
      "action-bar-padding": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "Space inside TableActionBar (8px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--table-action-bar-padding"
          }
        }
      },
      "action-bar-top": {
        "$type": "dimension",
        "$value": "{spacing.spacing-0}",
        "$description": "How far below the top of the page a sticky TableActionBar stops: the height of your own sticky header, if the page has one.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--table-action-bar-top"
          }
        }
      }
    },
    "border": {
      "border-width": {
        "$type": "dimension",
        "$value": "{borders.border-width-1}",
        "$description": "The frame and row lines (1px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--table-border-width"
          }
        }
      },
      "indicator-width": {
        "$type": "dimension",
        "$value": "{borders.highlight-indicator-width}",
        "$description": "The width of the selected row's bar: none by default, 2px with more contrast. Forced colors always draw a 2px border there.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--table-indicator-width"
          }
        }
      }
    },
    "radius": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.radius-surface}",
        "$description": "The frame's corners (8px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--table-radius"
          }
        }
      }
    }
  }
}
