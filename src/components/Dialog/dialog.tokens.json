{
  "dialog": {
    "$description": "Dialog's component tokens. Each one is an optional override: set the CSS variable (--dialog-<name>) on the page, a container or one dialog, and every Dialog inside follows. Unset, it uses the shared token it references here; tools/test/foundation.mjs checks that bundle.css uses exactly these defaults.",
    "color": {
      "row-bg-hover": {
        "$type": "color",
        "$value": "{color.surface-raised-hover}",
        "$description": "A List or InlineEdit row in the dialog, hovered or selected: a step up from its surface in dark",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--dialog-row-bg-hover"
          }
        }
      },
      "field-bg": {
        "$type": "color",
        "$value": "{color.field-raised}",
        "$description": "The fill of a form field in the dialog: a step up from its surface in dark, so the field stands out from it",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--dialog-field-bg"
          }
        }
      },
      "field-placeholder": {
        "$type": "color",
        "$value": "{color.field-raised-placeholder}",
        "$description": "Placeholder and other gray text in a form field in the dialog: `field-raised-placeholder`, lighter in dark so it keeps 4.5:1 on the raised field.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--dialog-field-placeholder"
          }
        }
      },
      "bg": {
        "$type": "color",
        "$value": "{color.surface-raised}",
        "$description": "The panel's background.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--dialog-bg"
          }
        }
      },
      "text": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "The panel's text: the body and the footer.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--dialog-text"
          }
        }
      },
      "overlay": {
        "$type": "color",
        "$value": "{color.backdrop}",
        "$description": "The dimmed backdrop over the page.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--dialog-overlay"
          }
        }
      },
      "title-color": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "The title.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--dialog-title-color"
          }
        }
      },
      "description-color": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "The description under the title (4.5:1 on surface).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--dialog-description-color"
          }
        }
      },
      "focus-ring": {
        "$type": "color",
        "$value": "{color.focus-ring}",
        "$description": "The keyboard focus ring of a body that scrolls.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--dialog-focus-ring"
          }
        }
      },
      "divider": {
        "$type": "color",
        "$value": "{color.border-raised}",
        "$description": "What a divider or separator inside it reads as `border`: its own edge color, since in dark `border` is the surface's own color and a line in it vanished",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--dialog-divider"
          }
        }
      }
    },
    "shadow": {
      "shadow": {
        "$type": "shadow",
        "$value": "{shadow.elevation-modal}",
        "$description": "The panel's shadow.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--dialog-shadow"
          }
        }
      }
    },
    "border": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.radius-container}",
        "$description": "The panel's corners (12px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--dialog-radius"
          }
        }
      }
    },
    "sizing": {
      "width-sm": {
        "$type": "dimension",
        "$value": "{sizing.container-sm}",
        "$description": "size=\"sm\" (384px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--dialog-width-sm"
          }
        }
      },
      "width-md": {
        "$type": "dimension",
        "$value": "{sizing.container-lg}",
        "$description": "size=\"md\", the default (512px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--dialog-width-md"
          }
        }
      },
      "width-lg": {
        "$type": "dimension",
        "$value": "{sizing.container-2xl}",
        "$description": "size=\"lg\" (672px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--dialog-width-lg"
          }
        }
      }
    },
    "spacing": {
      "padding": {
        "$type": "dimension",
        "$value": "{spacing.space-surface}",
        "$description": "Padding inside the panel (24px; 16px on screens under 640px wide).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--dialog-padding"
          }
        }
      },
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Space between the header, body and footer (16px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--dialog-gap"
          }
        }
      },
      "margin": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "The least space between the panel and the edge of the screen (16px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--dialog-margin"
          }
        }
      }
    },
    "typography": {
      "title-weight": {
        "$type": "fontWeight",
        "$value": "{typography.font-semibold}",
        "$description": "The title's weight (600).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--dialog-title-weight"
          }
        }
      }
    }
  }
}
