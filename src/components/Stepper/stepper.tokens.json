{
  "stepper": {
    "$description": "Stepper's component tokens. Each one is an optional override: set the CSS variable (--stepper-<name>) on the page, a container or one stepper, and every Stepper inside follows. Unset, it uses the shared token it references here; tools/test/foundation.mjs checks that bundle.css uses exactly these defaults.",
    "color": {
      "indicator-bg": {
        "$type": "color",
        "$value": "{color.surface}",
        "$description": "An upcoming step's circle.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--stepper-indicator-bg"
          }
        }
      },
      "indicator-border": {
        "$type": "color",
        "$value": "{color.border-strong}",
        "$description": "An upcoming step's ring (3:1 on the surface).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--stepper-indicator-border"
          }
        }
      },
      "indicator-text": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "An upcoming step's number.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--stepper-indicator-text"
          }
        }
      },
      "indicator-text-shaded": {
        "$type": "color",
        "$value": "{color.text-secondary}",
        "$description": "An upcoming step's number while its head is held down (4.5:1 on the washed fill).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--stepper-indicator-text-shaded"
          }
        }
      },
      "wash-pressed": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "The color washed over a step's indicator while its head is held down, at layer-pressed strength.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--stepper-wash-pressed"
          }
        }
      },
      "bg-active": {
        "$type": "color",
        "$value": "{color.surface-brand}",
        "$description": "The current and completed steps' circle.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--stepper-bg-active"
          }
        }
      },
      "text-active": {
        "$type": "color",
        "$value": "{color.text-on-brand}",
        "$description": "The number or check on them.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--stepper-text-active"
          }
        }
      },
      "bg-error": {
        "$type": "color",
        "$value": "{color.surface-danger}",
        "$description": "A step with an error.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--stepper-bg-error"
          }
        }
      },
      "text-error": {
        "$type": "color",
        "$value": "{color.text-on-danger}",
        "$description": "The mark on it.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--stepper-text-error"
          }
        }
      },
      "warning-bg": {
        "$type": "color",
        "$value": "{color.surface-warning-subtle}",
        "$description": "A step with a warning.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--stepper-warning-bg"
          }
        }
      },
      "warning-border": {
        "$type": "color",
        "$value": "{color.text-warning}",
        "$description": "Its ring.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--stepper-warning-border"
          }
        }
      },
      "warning-text": {
        "$type": "color",
        "$value": "{color.text-warning}",
        "$description": "The mark on it.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--stepper-warning-text"
          }
        }
      },
      "title-color": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "Step titles.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--stepper-title-color"
          }
        }
      },
      "description-color": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "The line under a title, and \"Optional\".",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--stepper-description-color"
          }
        }
      },
      "connector": {
        "$type": "color",
        "$value": "{color.border-strong}",
        "$description": "The line to an upcoming step.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--stepper-connector"
          }
        }
      },
      "connector-complete": {
        "$type": "color",
        "$value": "{color.surface-brand}",
        "$description": "The line after a completed step.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--stepper-connector-complete"
          }
        }
      },
      "focus-ring": {
        "$type": "color",
        "$value": "{color.focus-ring}",
        "$description": "A clickable step's keyboard focus ring.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--stepper-focus-ring"
          }
        }
      },
      "edge-active": {
        "$type": "color",
        "$value": "{color.border-brand}",
        "$description": "The current and complete steps' edge and the complete connector's, inside their fill (Yellow Light; transparent where the fill is 3:1 on the page)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--stepper-edge-active"
          }
        }
      }
    },
    "sizing": {
      "indicator-size-sm": {
        "$type": "dimension",
        "$value": "{spacing.spacing-6}",
        "$description": "The circle, size=\"sm\" (24px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--stepper-indicator-size-sm"
          }
        }
      },
      "indicator-size-md": {
        "$type": "dimension",
        "$value": "{spacing.spacing-8}",
        "$description": "The circle, size=\"md\", the default (32px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--stepper-indicator-size-md"
          }
        }
      }
    },
    "borders": {
      "connector-width": {
        "$type": "dimension",
        "$value": "{borders.border-width-2}",
        "$description": "The line's thickness (2px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--stepper-connector-width"
          }
        }
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.radius-pill}",
        "$description": "The circle.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--stepper-radius"
          }
        }
      }
    },
    "spacing": {
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3}",
        "$description": "Space between a circle and its text (12px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--stepper-gap"
          }
        }
      },
      "connector-gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "Space around a line (8px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--stepper-connector-gap"
          }
        }
      }
    },
    "typography": {
      "title-weight": {
        "$type": "fontWeight",
        "$value": "{typography.font-medium}",
        "$description": "Step titles (500).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--stepper-title-weight"
          }
        }
      }
    },
    "motion": {
      "press-scale": {
        "$type": "number",
        "$value": "{transforms.scale-100}",
        "$description": "Size of a step's indicator while its head is held down. 100%: off by default, since a press shows as the held wash (layer-pressed). Set it, e.g. to `var(--scale-95)`, to add a shrink.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--stepper-press-scale"
          }
        }
      },
      "layer-pressed": {
        "$type": "number",
        "$value": "{opacity.opacity-10}",
        "$description": "How strong the wash of the text color is on a step's indicator while its head is held down (10%).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--stepper-layer-pressed"
          }
        }
      }
    }
  }
}
