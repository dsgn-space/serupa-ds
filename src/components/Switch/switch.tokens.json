{
  "switch": {
    "$description": "Switch's component tokens. Each one is an optional override: set the CSS variable (--switch-<name>) on the page, a container or one switch, and every Switch inside follows. Unset, it uses the shared token it references here; tools/test/foundation.mjs checks that bundle.css uses exactly these defaults.",
    "color": {
      "track": {
        "$type": "color",
        "$value": "{color.border-control}",
        "$description": "The track while off",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--switch-track"
          }
        }
      },
      "track-hover": {
        "$type": "color",
        "$value": "{color.border-control-hover}",
        "$description": "The track while off, on hover",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--switch-track-hover"
          }
        }
      },
      "track-pressed": {
        "$type": "color",
        "$value": "{color.border-control-pressed}",
        "$description": "The off track while held down, one step past track-hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--switch-track-pressed"
          }
        }
      },
      "track-checked": {
        "$type": "color",
        "$value": "{color.primary}",
        "$description": "The track while on",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--switch-track-checked"
          }
        }
      },
      "track-checked-hover": {
        "$type": "color",
        "$value": "{color.primary-hover}",
        "$description": "The track while on, on hover",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--switch-track-checked-hover"
          }
        }
      },
      "track-checked-pressed": {
        "$type": "color",
        "$value": "{color.primary-pressed}",
        "$description": "The on track while held down, one step past track-checked-hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--switch-track-checked-pressed"
          }
        }
      },
      "thumb": {
        "$type": "color",
        "$value": "{color.field}",
        "$description": "The thumb while off",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--switch-thumb"
          }
        }
      },
      "thumb-checked": {
        "$type": "color",
        "$value": "{color.on-primary}",
        "$description": "The thumb while on",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--switch-thumb-checked"
          }
        }
      },
      "icon": {
        "$type": "color",
        "$value": "{color.primary}",
        "$description": "The check on the thumb while on, with icon (3:1 on the thumb)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--switch-icon"
          }
        }
      },
      "label-color": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "The label",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--switch-label-color"
          }
        }
      },
      "description-color": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "The description",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--switch-description-color"
          }
        }
      },
      "focus-ring": {
        "$type": "color",
        "$value": "{color.focus-ring}",
        "$description": "The focus ring",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--switch-focus-ring"
          }
        }
      },
      "invalid": {
        "$type": "color",
        "$value": "{color.danger}",
        "$description": "The track's edge and the focus ring, when invalid",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--switch-invalid"
          }
        }
      },
      "pending": {
        "$type": "color",
        "$value": "{color.primary-text}",
        "$description": "pending's ring on the off thumb (3:1 on it)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--switch-pending"
          }
        }
      },
      "pending-checked": {
        "$type": "color",
        "$value": "{color.primary}",
        "$description": "pending's ring on the on thumb (3:1 on it)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--switch-pending-checked"
          }
        }
      },
      "border-disabled": {
        "$type": "color",
        "$value": "{color.disabled-border}",
        "$description": "Disabled: the edge.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--switch-border-disabled"
          }
        }
      },
      "fill-disabled": {
        "$type": "color",
        "$value": "{color.disabled-surface}",
        "$description": "Disabled: the fill, whatever its color when enabled.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--switch-fill-disabled"
          }
        }
      },
      "text-disabled": {
        "$type": "color",
        "$value": "{color.disabled-text}",
        "$description": "Disabled: the text, icon or mark, in place of fading it (3:1 or more on its background, more with more contrast).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--switch-text-disabled"
          }
        }
      }
    },
    "sizing": {
      "width-sm": {
        "$type": "dimension",
        "$value": "{spacing.spacing-7}",
        "$description": "Track width, sm (28px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--switch-width-sm"
          }
        }
      },
      "width-md": {
        "$type": "dimension",
        "$value": "{spacing.spacing-9}",
        "$description": "Track width, md (36px, default).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--switch-width-md"
          }
        }
      },
      "width-lg": {
        "$type": "dimension",
        "$value": "{spacing.spacing-11}",
        "$description": "Track width, lg (44px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--switch-width-lg"
          }
        }
      },
      "height-sm": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Track height, sm (16px, the text-xs line).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--switch-height-sm"
          }
        }
      },
      "height-md": {
        "$type": "dimension",
        "$value": "{spacing.spacing-5}",
        "$description": "Track height, md (20px, the text-sm line).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--switch-height-md"
          }
        }
      },
      "height-lg": {
        "$type": "dimension",
        "$value": "{spacing.spacing-6}",
        "$description": "Track height, lg (24px, the text-base line).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--switch-height-lg"
          }
        }
      },
      "thumb-size-sm": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3}",
        "$description": "Thumb size, sm (12px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--switch-thumb-size-sm"
          }
        }
      },
      "thumb-size-md": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Thumb size, md (16px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--switch-thumb-size-md"
          }
        }
      },
      "thumb-size-lg": {
        "$type": "dimension",
        "$value": "{spacing.spacing-5}",
        "$description": "Thumb size, lg (20px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--switch-thumb-size-lg"
          }
        }
      }
    },
    "spacing": {
      "padding": {
        "$type": "dimension",
        "$value": "{spacing.spacing-0_5}",
        "$description": "Thumb to the track's ends (2px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--switch-padding"
          }
        }
      },
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "Track to label (8px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--switch-gap"
          }
        }
      }
    },
    "motion": {
      "press-scale": {
        "$type": "number",
        "$value": "{transforms.scale-100}",
        "$description": "Size of the thumb while it's held down. 100%: off by default, since a press shows as the held track (track-pressed, track-checked-pressed). Set it, e.g. to `var(--scale-90)`, to add a shrink.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--switch-press-scale"
          }
        }
      }
    }
  }
}
