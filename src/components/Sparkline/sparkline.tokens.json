{
  "sparkline": {
    "$description": "Sparkline's component tokens. Each one is an optional override: set the CSS variable (--sparkline-<name>) on the page, a container or one Sparkline, and every Sparkline inside follows. Unset, it uses the shared token it references here; tools/test/foundation.mjs checks that bundle.css uses exactly these defaults.",
    "color": {
      "line": {
        "$type": "color",
        "$value": "{color.chart-1}",
        "$description": "The line and the end dot (3:1 on the surface behind).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--sparkline-line"
          }
        }
      },
      "area": {
        "$type": "color",
        "$value": "{color.chart-seq-1}",
        "$description": "The fill under the line, with area.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--sparkline-area"
          }
        }
      }
    },
    "sizing": {
      "width": {
        "$type": "dimension",
        "$value": "{spacing.spacing-20}",
        "$description": "The width (80px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--sparkline-width"
          }
        }
      },
      "height": {
        "$type": "dimension",
        "$value": "{spacing.spacing-5}",
        "$description": "The height (20px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--sparkline-height"
          }
        }
      },
      "dot": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1_5}",
        "$description": "The end dot's diameter (6px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--sparkline-dot"
          }
        }
      }
    }
  }
}
