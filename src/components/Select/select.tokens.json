{
  "select": {
    "$description": "Select's component tokens. Each one is an optional override: set the CSS variable (--select-<name>) on the page, a container or one select, and every Select inside follows. Unset, it uses the shared token it references here, the same ones Input uses; tools/test/foundation.mjs checks that bundle.css uses exactly these defaults.",
    "color": {
      "bg": {
        "$type": "color",
        "$value": "{color.field}",
        "$description": "Background, and the options where the browser draws them",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-bg"
          }
        }
      },
      "bg-disabled": {
        "$type": "color",
        "$value": "{color.field-readonly}",
        "$description": "Background when read-only or disabled",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-bg-disabled"
          }
        }
      },
      "text": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "The chosen value, and the options where the browser draws them",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-text"
          }
        }
      },
      "border": {
        "$type": "color",
        "$value": "{color.field-border}",
        "$description": "Border",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-border"
          }
        }
      },
      "border-hover": {
        "$type": "color",
        "$value": "{color.field-border-hover}",
        "$description": "Border on hover",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-border-hover"
          }
        }
      },
      "placeholder": {
        "$type": "color",
        "$value": "{color.placeholder}",
        "$description": "The placeholder",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-placeholder"
          }
        }
      },
      "icon-color": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "Chevron and left icon",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-icon-color"
          }
        }
      },
      "focus-ring": {
        "$type": "color",
        "$value": "{color.focus-ring}",
        "$description": "Border and ring while focused",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-focus-ring"
          }
        }
      },
      "invalid": {
        "$type": "color",
        "$value": "{color.field-border-invalid}",
        "$description": "Border and ring when invalid",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-invalid"
          }
        }
      },
      "picker-bg": {
        "$type": "color",
        "$value": "{color.surface-overlay}",
        "$description": "The list of options, where the browser draws it with the page's styles (appearance: base-select).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-picker-bg"
          }
        }
      },
      "picker-border": {
        "$type": "color",
        "$value": "{color.border-overlay}",
        "$description": "The list's border.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-picker-border"
          }
        }
      },
      "option-bg-active": {
        "$type": "color",
        "$value": "{color.highlight}",
        "$description": "The option under the pointer or the keyboard, as Combobox's.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-option-bg-active"
          }
        }
      },
      "option-indicator": {
        "$type": "color",
        "$value": "{color.highlight-indicator}",
        "$description": "The 2px bar at the highlighted item's start: none by default (the grey fill marks it), `text`-dark with more contrast.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-option-indicator"
          }
        }
      },
      "check": {
        "$type": "color",
        "$value": "{color.primary}",
        "$description": "The tick by the chosen option.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-check"
          }
        }
      },
      "group-label": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "A group's name over its options.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-group-label"
          }
        }
      }
    },
    "sizing": {
      "height-sm": {
        "$type": "dimension",
        "$value": "{sizing.control-height-sm}",
        "$description": "Height, sm (24px), like Input sm.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-height-sm"
          }
        }
      },
      "height-md": {
        "$type": "dimension",
        "$value": "{sizing.control-height-md}",
        "$description": "Height, md (32px, default).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-height-md"
          }
        }
      },
      "height-lg": {
        "$type": "dimension",
        "$value": "{sizing.control-height-lg}",
        "$description": "Height, lg (44px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-height-lg"
          }
        }
      },
      "icon-size-sm": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3_5}",
        "$description": "Icon size, sm (14px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-icon-size-sm"
          }
        }
      },
      "icon-size-md": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Icon size, md (16px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-icon-size-md"
          }
        }
      },
      "icon-size-lg": {
        "$type": "dimension",
        "$value": "{spacing.spacing-5}",
        "$description": "Icon size, lg (20px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-icon-size-lg"
          }
        }
      },
      "picker-max-height": {
        "$type": "dimension",
        "$value": "{spacing.spacing-60}",
        "$description": "The list's greatest height before it scrolls (240px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-picker-max-height"
          }
        }
      },
      "option-height": {
        "$type": "dimension",
        "$value": "{sizing.control-height-md}",
        "$description": "An option's least height (32px), where the list is styled.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-option-height"
          }
        }
      },
      "option-height-touch": {
        "$type": "dimension",
        "$value": "{sizing.control-height-lg}",
        "$description": "An option's least height on a touch screen (44px), where the list is styled.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-option-height-touch"
          }
        }
      }
    },
    "spacing": {
      "padding-x-sm": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "Side padding, sm (8px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-padding-x-sm"
          }
        }
      },
      "padding-x-md": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3}",
        "$description": "Side padding, md (12px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-padding-x-md"
          }
        }
      },
      "padding-x-lg": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Side padding, lg (16px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-padding-x-lg"
          }
        }
      },
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "Gap between an icon and the text (8px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-gap"
          }
        }
      },
      "picker-padding": {
        "$type": "dimension",
        "$value": "{spacing.spacing-1}",
        "$description": "Space inside the list, around the options (4px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-picker-padding"
          }
        }
      },
      "option-padding-x": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "An option's side padding (8px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-option-padding-x"
          }
        }
      }
    },
    "border": {
      "border-width": {
        "$type": "dimension",
        "$value": "{borders.border-width-1}",
        "$description": "Border width (1px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-border-width"
          }
        }
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.radius-control}",
        "$description": "Corner radius (6px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-radius"
          }
        }
      },
      "picker-radius": {
        "$type": "dimension",
        "$value": "{radius.radius-surface}",
        "$description": "The list's corners.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-picker-radius"
          }
        }
      }
    },
    "shadow": {
      "depth": {
        "$type": "shadow",
        "$value": "{shadow.depth-field}",
        "$description": "The tactile inner shade along the top of the box. None in the flat brands.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-depth"
          }
        }
      },
      "picker-shadow": {
        "$type": "shadow",
        "$value": "{shadow.elevation-overlay}",
        "$description": "The list's shadow, as other popups.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-picker-shadow"
          }
        }
      },
      "picker-depth": {
        "$type": "shadow",
        "$value": "{shadow.depth-surface}",
        "$description": "The list's tactile layer (none in the flat brands).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--select-picker-depth"
          }
        }
      }
    }
  }
}
