{
  "checkbox": {
    "$description": "Checkbox's component tokens. Each one is an optional override: set the CSS variable (--checkbox-<name>) on the page, a container or one checkbox, and every Checkbox inside follows. Unset, it uses the shared token it references here; tools/test/foundation.mjs checks that bundle.css uses exactly these defaults.",
    "color": {
      "bg": {
        "$type": "color",
        "$value": "{color.field}",
        "$description": "The box while unchecked",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-bg"
          }
        }
      },
      "bg-disabled": {
        "$type": "color",
        "$value": "{color.surface-muted}",
        "$description": "The box when disabled and unchecked",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-bg-disabled"
          }
        }
      },
      "bg-checked": {
        "$type": "color",
        "$value": "{color.primary}",
        "$description": "Fill and border when checked or indeterminate",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-bg-checked"
          }
        }
      },
      "bg-checked-hover": {
        "$type": "color",
        "$value": "{color.primary-hover}",
        "$description": "The same, on hover",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-bg-checked-hover"
          }
        }
      },
      "border": {
        "$type": "color",
        "$value": "{color.field-border}",
        "$description": "Border while unchecked",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-border"
          }
        }
      },
      "border-hover": {
        "$type": "color",
        "$value": "{color.field-border-hover}",
        "$description": "Border on hover",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-border-hover"
          }
        }
      },
      "icon-color": {
        "$type": "color",
        "$value": "{color.on-primary}",
        "$description": "The check and the dash",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-icon-color"
          }
        }
      },
      "label-color": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "The label",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-label-color"
          }
        }
      },
      "description-color": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "The description",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-description-color"
          }
        }
      },
      "focus-ring": {
        "$type": "color",
        "$value": "{color.focus-ring}",
        "$description": "The focus ring",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-focus-ring"
          }
        }
      },
      "invalid": {
        "$type": "color",
        "$value": "{color.field-border-invalid}",
        "$description": "Border and focus ring when invalid",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-invalid"
          }
        }
      },
      "card-bg": {
        "$type": "color",
        "$value": "{color.surface}",
        "$description": "A card checkbox's background.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-card-bg"
          }
        }
      },
      "card-border": {
        "$type": "color",
        "$value": "{color.border}",
        "$description": "A card's border.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-card-border"
          }
        }
      },
      "card-border-hover": {
        "$type": "color",
        "$value": "{color.field-border-hover}",
        "$description": "A card's border under the pointer.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-card-border-hover"
          }
        }
      },
      "card-border-checked": {
        "$type": "color",
        "$value": "{color.primary}",
        "$description": "A checked card's border, 2px.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-card-border-checked"
          }
        }
      }
    },
    "sizing": {
      "size-sm": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3_5}",
        "$description": "Box size, sm (14px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-size-sm"
          }
        }
      },
      "size-md": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Box size, md (16px, default).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-size-md"
          }
        }
      },
      "size-lg": {
        "$type": "dimension",
        "$value": "{spacing.spacing-5}",
        "$description": "Box size, lg (20px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-size-lg"
          }
        }
      },
      "icon-size-sm": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3}",
        "$description": "Check size, sm (12px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-icon-size-sm"
          }
        }
      },
      "icon-size-md": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3_5}",
        "$description": "Check size, md (14px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-icon-size-md"
          }
        }
      },
      "icon-size-lg": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Check size, lg (16px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-icon-size-lg"
          }
        }
      },
      "card-min-width": {
        "$type": "dimension",
        "$value": "{spacing.spacing-48}",
        "$description": "The narrowest a card gets in a horizontal group before the row wraps (192px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-card-min-width"
          }
        }
      }
    },
    "spacing": {
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "Box to label (8px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-gap"
          }
        }
      },
      "group-gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "Between boxes in a CheckboxGroup stack, and between rows (8px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-group-gap"
          }
        }
      },
      "group-gap-horizontal": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Between boxes in a CheckboxGroup row (16px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-group-gap-horizontal"
          }
        }
      },
      "card-padding": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Space inside a card (16px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-card-padding"
          }
        }
      },
      "card-gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3}",
        "$description": "Space between a card's box and its text (12px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-card-gap"
          }
        }
      },
      "card-group-gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3}",
        "$description": "Space between cards in a group (12px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-card-group-gap"
          }
        }
      }
    },
    "typography": {
      "card-label-weight": {
        "$type": "fontWeight",
        "$value": "{typography.font-medium}",
        "$description": "A card's label weight (500).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-card-label-weight"
          }
        }
      }
    },
    "border": {
      "border-width": {
        "$type": "dimension",
        "$value": "{borders.border-width-1}",
        "$description": "Border width (1px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-border-width"
          }
        }
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.radius-inner}",
        "$description": "Corner radius (4px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-radius"
          }
        }
      }
    },
    "radius": {
      "card-radius": {
        "$type": "dimension",
        "$value": "{radius.radius-surface}",
        "$description": "A card's corners (8px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-card-radius"
          }
        }
      }
    },
    "motion": {
      "press-scale": {
        "$type": "number",
        "$value": "{transforms.scale-90}",
        "$description": "Size of the box while it's held down (90%). 1 turns it off",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-press-scale"
          }
        }
      },
      "draw-duration": {
        "$type": "duration",
        "$value": "{transitions.motion-draw}",
        "$description": "How long the tick takes to draw itself on when ticked under the pointer or keyboard: 150ms in a tactile brand, at once in the flat ones.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-draw-duration"
          }
        }
      }
    },
    "shadow": {
      "depth": {
        "$type": "shadow",
        "$value": "{shadow.depth-well}",
        "$description": "The box's tactile layers while unticked: sunk into the page. None in the flat brands.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-depth"
          }
        }
      },
      "depth-checked": {
        "$type": "shadow",
        "$value": "{shadow.depth-part}",
        "$description": "The box's tactile layers once ticked: raised, with a highlight along the top. None in the flat brands.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-depth-checked"
          }
        }
      }
    }
  }
}
