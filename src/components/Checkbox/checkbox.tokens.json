{
  "checkbox": {
    "$description": "Checkbox's component tokens. Each one is an optional override: set the CSS variable (--checkbox-<name>) on the page, a container or one checkbox, and every Checkbox inside follows. Unset, it uses the shared token it references here; tools/test/foundation.mjs checks that bundle.css uses exactly these defaults.",
    "color": {
      "bg": {
        "$type": "color",
        "$value": "{color.field}",
        "$description": "The box while unchecked",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-bg"
          }
        }
      },
      "bg-disabled": {
        "$type": "color",
        "$value": "{color.field-readonly}",
        "$description": "The box when disabled and unchecked: a disabled field's fill, at or above the surface in dark rather than sunk below it",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-bg-disabled"
          }
        }
      },
      "bg-checked": {
        "$type": "color",
        "$value": "{color.primary}",
        "$description": "Fill and border when checked or indeterminate",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-bg-checked"
          }
        }
      },
      "bg-checked-hover": {
        "$type": "color",
        "$value": "{color.primary-hover}",
        "$description": "The same, on hover",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-bg-checked-hover"
          }
        }
      },
      "bg-checked-pressed": {
        "$type": "color",
        "$value": "{color.primary-pressed}",
        "$description": "The checked box's fill while held down, one step past bg-checked-hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-bg-checked-pressed"
          }
        }
      },
      "bg-pressed": {
        "$type": "color",
        "$value": "{color.secondary}",
        "$description": "The unchecked box's background while held down.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-bg-pressed"
          }
        }
      },
      "border": {
        "$type": "color",
        "$value": "{color.field-border}",
        "$description": "Border while unchecked",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-border"
          }
        }
      },
      "border-hover": {
        "$type": "color",
        "$value": "{color.field-border-hover}",
        "$description": "Border on hover",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-border-hover"
          }
        }
      },
      "border-pressed": {
        "$type": "color",
        "$value": "{color.field-border-pressed}",
        "$description": "The unchecked box's border while held down, one step past border-hover.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-border-pressed"
          }
        }
      },
      "icon-color": {
        "$type": "color",
        "$value": "{color.on-primary}",
        "$description": "The check and the dash",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-icon-color"
          }
        }
      },
      "label-color": {
        "$type": "color",
        "$value": "{color.text}",
        "$description": "The label",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-label-color"
          }
        }
      },
      "description-color": {
        "$type": "color",
        "$value": "{color.text-muted}",
        "$description": "The description",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-description-color"
          }
        }
      },
      "focus-ring": {
        "$type": "color",
        "$value": "{color.focus-ring}",
        "$description": "The focus ring",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-focus-ring"
          }
        }
      },
      "invalid": {
        "$type": "color",
        "$value": "{color.field-border-invalid}",
        "$description": "Border and focus ring when invalid",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-invalid"
          }
        }
      },
      "card-bg": {
        "$type": "color",
        "$value": "{color.surface}",
        "$description": "A card checkbox's background.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-card-bg"
          }
        }
      },
      "card-border": {
        "$type": "color",
        "$value": "{color.border}",
        "$description": "A card's border.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-card-border"
          }
        }
      },
      "card-border-hover": {
        "$type": "color",
        "$value": "{color.field-border-hover}",
        "$description": "A card's border under the pointer.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-card-border-hover"
          }
        }
      },
      "card-border-checked": {
        "$type": "color",
        "$value": "{color.primary-text}",
        "$description": "A checked card's border, 2px.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-card-border-checked"
          }
        }
      },
      "border-disabled": {
        "$type": "color",
        "$value": "{color.disabled-border}",
        "$description": "Disabled: the edge.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-border-disabled"
          }
        }
      },
      "fill-disabled": {
        "$type": "color",
        "$value": "{color.disabled-surface}",
        "$description": "Disabled: the fill, whatever its color when enabled.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-fill-disabled"
          }
        }
      },
      "text-disabled": {
        "$type": "color",
        "$value": "{color.disabled-text}",
        "$description": "Disabled: the text, icon or mark, in place of fading it (3:1 or more on its background, more with more contrast).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-text-disabled"
          }
        }
      },
      "edge-checked": {
        "$type": "color",
        "$value": "{color.primary-edge}",
        "$description": "A checked box's edge (Yellow Light; transparent where the fill is 3:1 on the page)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-edge-checked"
          }
        }
      }
    },
    "sizing": {
      "size-sm": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3_5}",
        "$description": "Box size, sm (14px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-size-sm"
          }
        }
      },
      "size-md": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Box size, md (16px, default).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-size-md"
          }
        }
      },
      "size-lg": {
        "$type": "dimension",
        "$value": "{spacing.spacing-5}",
        "$description": "Box size, lg (20px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-size-lg"
          }
        }
      },
      "icon-size-sm": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3}",
        "$description": "Check size, sm (12px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-icon-size-sm"
          }
        }
      },
      "icon-size-md": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3_5}",
        "$description": "Check size, md (14px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-icon-size-md"
          }
        }
      },
      "icon-size-lg": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Check size, lg (16px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-icon-size-lg"
          }
        }
      },
      "card-min-width": {
        "$type": "dimension",
        "$value": "{spacing.spacing-48}",
        "$description": "The narrowest a card gets in a horizontal group before the row wraps (192px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-card-min-width"
          }
        }
      }
    },
    "spacing": {
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "Box to label (8px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-gap"
          }
        }
      },
      "group-gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-2}",
        "$description": "Between boxes in a CheckboxGroup stack, and between rows (8px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-group-gap"
          }
        }
      },
      "group-gap-horizontal": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Between boxes in a CheckboxGroup row (16px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-group-gap-horizontal"
          }
        }
      },
      "card-padding": {
        "$type": "dimension",
        "$value": "{spacing.spacing-4}",
        "$description": "Space inside a card (16px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-card-padding"
          }
        }
      },
      "card-gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3}",
        "$description": "Space between a card's box and its text (12px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-card-gap"
          }
        }
      },
      "card-group-gap": {
        "$type": "dimension",
        "$value": "{spacing.spacing-3}",
        "$description": "Space between cards in a group (12px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-card-group-gap"
          }
        }
      }
    },
    "typography": {
      "card-label-weight": {
        "$type": "fontWeight",
        "$value": "{typography.font-medium}",
        "$description": "A card's label weight (500).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-card-label-weight"
          }
        }
      }
    },
    "border": {
      "border-width": {
        "$type": "dimension",
        "$value": "{borders.border-width-1}",
        "$description": "Border width (1px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-border-width"
          }
        }
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.radius-inner}",
        "$description": "Corner radius (4px)",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-radius"
          }
        }
      }
    },
    "radius": {
      "card-radius": {
        "$type": "dimension",
        "$value": "{radius.radius-surface}",
        "$description": "A card's corners (8px).",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-card-radius"
          }
        }
      }
    },
    "motion": {
      "press-scale": {
        "$type": "number",
        "$value": "{transforms.scale-100}",
        "$description": "Size of the box while it's held down. 100%: off by default, since a press shows as the held colors (bg-pressed, border-pressed, bg-checked-pressed). Set it, e.g. to `var(--scale-90)`, to add a shrink.",
        "$extensions": {
          "com.serupa": {
            "cssVar": "--checkbox-press-scale"
          }
        }
      }
    }
  }
}
