#!/bin/sh
# A quick check before a push leaves this machine: tokens, build, types, lint and the component tests of what changed
# since the branch's last push (or since origin/main for a new branch), stopped after five minutes, so a push doesn't
# take a CI round to find a type error or a broken test. CI runs everything else. npm install sets it up
# (tools/git-hooks/install.mjs). A push that deletes a branch or carries no change skips it.
# SERUPA_SKIP_PREPUSH=1 skips the checks for one push (a bot, or a push of baselines CI drew); git push --no-verify does too.
zero=0000000000000000000000000000000000000000
run=
branches=
since=
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  run=1
  branches="$branches ${remote_ref#refs/heads/}"
  # What this push adds: since the branch's last push, when that is in its history.
  if [ "$remote_sha" != "$zero" ] && git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then since=$remote_sha; fi
done
[ -n "$run" ] || exit 0
# Never while Update baselines draws the branch's pictures (the update-visual-baselines label is on): its push of the
# pictures would be refused and the drawing thrown away. This holds even when SERUPA_SKIP_PREPUSH skips the checks.
if command -v gh >/dev/null 2>&1; then
  for b in $branches; do
    if gh pr list --head "$b" --state open --json labels --jq '.[].labels[].name' 2>/dev/null | grep -qx update-visual-baselines; then
      echo "pre-push: Update baselines is drawing $b's pictures (the update-visual-baselines label is on). Push after it commits them and takes the label off." >&2
      exit 1
    fi
  done
fi
[ "${SERUPA_SKIP_PREPUSH:-}" = 1 ] && exit 0
if [ -z "$since" ]; then
  git fetch -q origin main || { echo "pre-push: couldn't fetch origin/main; run node tools/ci.mjs --since origin/main yourself." >&2; exit 1; }
  since=origin/main
fi
# Git runs a hook with GIT_DIR (and in a worktree GIT_WORK_TREE, GIT_INDEX_FILE) set to this repository. The checks
# make throwaway repositories of their own, and with these set their commits landed in this branch instead (six
# commits and the tree replaced by four files, on a worktree, 12 Nov). Clear every variable that points git here.
unset $(git rev-parse --local-env-vars)
steps=tokens,build,typecheck,lint,components
echo "pre-push: node tools/ci.mjs --only $steps --since $since, five minutes at most (SERUPA_SKIP_PREPUSH=1 skips it)" >&2
if command -v timeout >/dev/null 2>&1; then
  timeout 300 node tools/ci.mjs --only "$steps" --since "$since" </dev/null
  status=$?
  if [ "$status" = 124 ]; then echo "pre-push: five minutes passed with nothing failing; CI tests the rest." >&2; exit 0; fi
  exit "$status"
fi
exec node tools/ci.mjs --only "$steps" --since "$since" </dev/null
