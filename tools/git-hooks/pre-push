#!/bin/sh
# Runs what CI requires on a pull request (node tools/ci.mjs --since origin/main) before a push leaves this machine, so a
# pull request doesn't take a CI round, or a merge-queue group, to find what this run finds. npm install sets it up
# (tools/git-hooks/install.mjs). A push that deletes a branch or carries no change to test skips it.
# SERUPA_SKIP_PREPUSH=1 skips it for one push (a bot, or a push of baselines CI drew); git push --no-verify does too.
[ "${SERUPA_SKIP_PREPUSH:-}" = 1 ] && exit 0
zero=0000000000000000000000000000000000000000
run=
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  run=1
done
[ -n "$run" ] || exit 0
git fetch -q origin main || { echo "pre-push: couldn't fetch origin/main; run node tools/ci.mjs --since origin/main yourself." >&2; exit 1; }
echo "pre-push: node tools/ci.mjs --since origin/main (SERUPA_SKIP_PREPUSH=1 skips it)" >&2
exec node tools/ci.mjs --since origin/main </dev/null
